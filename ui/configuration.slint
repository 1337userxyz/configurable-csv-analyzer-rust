import { Button, LineEdit, CheckBox, ScrollView, ComboBox, StandardButton } from "std-widgets.slint";

export struct SlintViewItem {
    id: int,
    name: string,
    is_default: bool,
    file_count: int,
    spreadsheet_path: string,
    base_path: string,
    color_pattern: string,
    export_color_pattern: string,
}

export struct SlintViewFileItem {
    id: int,
    file_name: string,
    dir_path: string,
    relative_path: string,
    info_file_path: string,
    storage_mode: string,
    integrity_status: string,
    can_relocate: bool,
    expected_info_path: string,
}

export struct SlintBrushItem {
    key: string,
    hex_value: string,
    category: string,
    is_system: bool,
    color: color,
}

export struct SlintExternalAppItem {
    id: int,
    name: string,
    command_or_path: string,
    arguments: string,
}

component ConfigDeleteButton inherits Rectangle {
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 5px;
    background: ta.has-hover ? #dc2626 : #352227;
    border-width: 1px;
    border-color: ta.has-hover ? #f87171 : #5c2b33;

    Text {
        text: "✕";
        color: ta.has-hover ? #ffffff : #fca5a5;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ConfigurationWindow inherits Window {
    title: "Hauptkonfiguration - Configurable CSV & ODS Analyzer";
    min-width: 980px;
    min-height: 680px;
    preferred-width: 1060px;
    preferred-height: 720px;
    background: #1e1e24;
    default-font-family: "Segoe UI, Inter, Roboto, sans-serif";
    default-font-size: 13px;

    // Callbacks to Rust
    callback save_and_close_clicked();
    callback cancel_clicked();

    // Tab selection
    in-out property <int> active_nav_tab: 0; // 0: Views, 1: Storage, 2: Brushes, 3: Associations

    // Views State
    in-out property <[SlintViewItem]> views: [];
    in-out property <int> selected_view_idx: 0;
    in-out property <string> current_view_name: "";
    in-out property <[SlintViewFileItem]> current_view_files: [];
    in-out property <int> selected_file_idx: -1;
    in-out property <string> new_view_name_input: "";
    in-out property <string> current_spreadsheet_path: "";
    in-out property <string> current_base_path: "";
    in-out property <string> current_color_pattern: "None";
    in-out property <string> current_export_color_pattern: "None";

    // Rename modal
    in-out property <bool> rename_modal_visible: false;
    in-out property <string> rename_modal_input: "";
    callback confirm_rename_modal(string);

    callback select_view(int);
    callback view_name_edited(string);
    callback add_view_clicked(string);
    callback delete_view_clicked(int);
    callback set_default_view_clicked(int);
    callback move_view_up(int);
    callback move_view_down(int);
    callback browse_spreadsheet_clicked();
    callback create_spreadsheet_clicked();
    callback spreadsheet_path_edited(string);
    callback clear_spreadsheet_clicked();
    callback browse_base_path_clicked();
    callback scan_base_path_clicked();
    callback base_path_edited(string);
    callback view_patterns_changed(string, string);

    callback add_csv_to_view_clicked();
    callback add_folder_to_view_clicked();
    callback import_open_tabs_to_view_clicked();
    callback remove_file_from_view_clicked(int);
    callback move_file_up(int);
    callback move_file_down(int);
    callback migrate_info_file_clicked(int);
    callback relocate_info_file_clicked(int);
    callback relocate_all_info_files_clicked();
    callback open_info_editor_for_file_clicked(int);
    callback diff_info_file_clicked(int);

    // Storage State
    in-out property <int> selected_storage_mode: 0; // 0: Dateipfad, 1: Stammverzeichnis, 2: Temporaer, 3: BenutzerEntscheidet
    in-out property <string> central_directory_path: "./Configs";
    callback storage_mode_changed(int);
    callback browse_central_directory();
    callback central_directory_edited(string);

    // Brushes State
    in-out property <[SlintBrushItem]> brushes: [];
    in-out property <string> brush_search_query: "";
    in-out property <int> selected_brush_idx: -1;
    in-out property <string> edit_brush_key: "";
    in-out property <string> edit_brush_hex: "#ffffff";
    in-out property <string> edit_brush_category: "Status";
    in-out property <bool> edit_brush_is_system: false;
    in-out property <int> marker_priority: 100;

    callback brush_selected(int);
    callback brush_search_changed(string);
    callback update_brush_clicked(string, string, string);
    callback add_brush_clicked(string, string, string);
    callback delete_brush_clicked(string);
    callback marker_priority_changed(int);

    // Associations State
    in-out property <bool> check_associations_on_startup: false;
    in-out property <string> association_status_message: "Bereit";
    callback toggle_associations_startup(bool);
    callback register_associations_now();

    // External Apps State (Tab 4)
    in-out property <[SlintExternalAppItem]> external_apps: [];
    in-out property <int> selected_app_idx: -1;
    in-out property <string> edit_app_name: "";
    in-out property <string> edit_app_path: "";
    in-out property <string> edit_app_arguments: "";

    callback select_app(int);
    callback add_app_clicked(string, string, string);
    callback update_app_clicked(int, string, string, string);
    callback delete_app_clicked(int);
    callback move_app_up(int);
    callback move_app_down(int);
    callback browse_app_path_clicked();

    // Diff preview modal
    in-out property <bool> diff_modal_visible: false;
    in-out property <string> diff_modal_text: "";
    callback close_diff_modal();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // TOP HEADER
        Rectangle {
            height: 48px;
            background: #252530;
            border-radius: 8px;
            border-width: 1px;
            border-color: #38384a;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "⚙ Hauptkonfiguration";
                        font-size: 16px;
                        font-weight: 700;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "|";
                        color: #55556a;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Kollektionen (Views), Speicherorte, Farbkatalog & System";
                        font-size: 12px;
                        color: #9e9eb4;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;

                    // Navigation Tabs
                    Button {
                        text: "📁 Ansichten & Pfade";
                        primary: root.active_nav_tab == 0;
                        clicked => { root.active_nav_tab = 0; }
                    }
                    Button {
                        text: "💾 Speicherorte";
                        primary: root.active_nav_tab == 1;
                        clicked => { root.active_nav_tab = 1; }
                    }
                    Button {
                        text: "🎨 Farbkatalog";
                        primary: root.active_nav_tab == 2;
                        clicked => { root.active_nav_tab = 2; }
                    }
                    Button {
                        text: "🔗 Dateiverknüpfungen";
                        primary: root.active_nav_tab == 3;
                        clicked => { root.active_nav_tab = 3; }
                    }
                    Button {
                        text: "🚀 Externe Programme";
                        primary: root.active_nav_tab == 4;
                        clicked => { root.active_nav_tab = 4; }
                    }
                }
            }
        }

        // MAIN CONTENT BODY (Switched by active_nav_tab)
        Rectangle {
            vertical-stretch: 1;
            background: #22222b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #38384a;

            // TAB 0: ANSICHTEN & PFADE ("VIEWS")
            if root.active_nav_tab == 0: HorizontalLayout {
                padding: 14px;
                spacing: 14px;

                // Left: List of Views
                Rectangle {
                    width: 290px;
                    background: #1b1b23;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #313142;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Kollektionen / Ansichten (Views)";
                            font-weight: 600;
                            color: #ffffff;
                        }

                        // Add view row
                        HorizontalLayout {
                            spacing: 6px;
                            LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "Neue Kollektion...";
                                text <=> root.new_view_name_input;
                                edited(s) => { root.new_view_name_input = s; }
                                accepted => {
                                    if root.new_view_name_input != "" {
                                        root.add_view_clicked(root.new_view_name_input);
                                        root.new_view_name_input = "";
                                    }
                                }
                            }
                            Button {
                                text: "+";
                                primary: true;
                                clicked => {
                                    if root.new_view_name_input != "" {
                                        root.add_view_clicked(root.new_view_name_input);
                                        root.new_view_name_input = "";
                                    } else {
                                        root.add_view_clicked("Neue Kollektion");
                                    }
                                }
                            }
                        }

                        // Views List
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                for v[idx] in root.views: Rectangle {
                                    height: 38px;
                                    background: root.selected_view_idx == idx ? #2d3b59 : #242431;
                                    border-radius: 5px;
                                    border-width: root.selected_view_idx == idx ? 1.5px : 1px;
                                    border-color: root.selected_view_idx == idx ? #60a5fa : #353549;

                                    TouchArea {
                                        clicked => {
                                            root.selected_view_idx = idx;
                                            root.select_view(idx);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 6px;

                                            Text {
                                                text: v.name;
                                                font-weight: root.selected_view_idx == idx ? 600 : 400;
                                                color: root.selected_view_idx == idx ? #ffffff : #d0d0e0;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            if v.is_default: VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 54px;
                                                    height: 18px;
                                                    background: #1e3a2f;
                                                    border-radius: 3px;
                                                    Text {
                                                        text: "Standard";
                                                        font-size: 10px;
                                                        color: #66bb6a;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        Text {
                                            text: v.file_count + " Tab.";
                                            font-size: 11px;
                                            color: #8c8ca0;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // View Action Buttons
                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                text: "▲";
                                enabled: root.selected_view_idx > 0;
                                clicked => { root.move_view_up(root.selected_view_idx); }
                            }
                            Button {
                                text: "▼";
                                enabled: root.selected_view_idx < root.views.length - 1;
                                clicked => { root.move_view_down(root.selected_view_idx); }
                            }
                            Button {
                                text: "Als Standard";
                                enabled: root.views.length > 0;
                                clicked => { root.set_default_view_clicked(root.selected_view_idx); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                horizontal-stretch: 1;
                                text: "✏️ Umbenennen...";
                                enabled: root.views.length > 0;
                                clicked => {
                                    root.rename_modal_input = root.current_view_name;
                                    root.rename_modal_visible = true;
                                }
                            }
                            Button {
                                text: "🗑 Löschen";
                                enabled: root.views.length > 0;
                                clicked => { root.delete_view_clicked(root.selected_view_idx); }
                            }
                        }
                    }
                }

                // Right: Details & Files of selected view
                Rectangle {
                    vertical-stretch: 1;
                    background: #1b1b23;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #313142;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        // View Meta Settings (Name, ODS, Patterns)
                        HorizontalLayout {
                            spacing: 10px;

                            Text {
                                text: "🏷️ Kollektionsname:";
                                font-weight: 600;
                                color: #e2e8f0;
                                vertical-alignment: center;
                                width: 135px;
                            }
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.current_view_name;
                                placeholder-text: "Name der Kollektion...";
                                edited(s) => {
                                    root.current_view_name = s;
                                    root.view_name_edited(s);
                                }
                            }
                            Button {
                                text: "✏️ Umbenennen...";
                                clicked => {
                                    root.rename_modal_input = root.current_view_name;
                                    root.rename_modal_visible = true;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            Text {
                                text: "Verknüpftes ODS:";
                                color: #b0b0c4;
                                vertical-alignment: center;
                                width: 135px;
                            }
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.current_spreadsheet_path;
                                placeholder-text: "Pfad zu bestehender oder neuer .ods-Datei...";
                                edited(s) => {
                                    root.current_spreadsheet_path = s;
                                    root.spreadsheet_path_edited(s);
                                }
                            }
                            Button {
                                text: "📂 ODS wählen...";
                                clicked => { root.browse_spreadsheet_clicked(); }
                            }
                            Button {
                                text: "➕ Neu erstellen...";
                                primary: true;
                                clicked => { root.create_spreadsheet_clicked(); }
                            }
                            Button {
                                text: "Entfernen";
                                clicked => { root.clear_spreadsheet_clicked(); }
                            }
                        }

                        // Collection Base Path (Basispfad pro Kollektion & Scan-Funktion)
                        HorizontalLayout {
                            spacing: 10px;

                            Text {
                                text: "📁 Basispfad:";
                                color: #b0b0c4;
                                vertical-alignment: center;
                                width: 135px;
                            }
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.current_base_path;
                                placeholder-text: "Basispfad für diese Kollektion (z. B. C:/Daten/09G31)...";
                                edited(s) => {
                                    root.current_base_path = s;
                                    root.base_path_edited(s);
                                }
                            }
                            Button {
                                text: "📂 Ordner wählen...";
                                clicked => { root.browse_base_path_clicked(); }
                            }
                            Button {
                                text: "🔍 Ordner scannen";
                                primary: true;
                                enabled: root.current_base_path != "";
                                clicked => { root.scan_base_path_clicked(); }
                            }
                        }

                        // Pattern row
                        HorizontalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Farbmuster Grid:"; color: #b0b0c4; vertical-alignment: center; }
                                ComboBox {
                                    width: 160px;
                                    model: ["None", "Original", "OriginalPlusZebra", "Zebra"];
                                    current-value: root.current_color_pattern;
                                    selected(s) => {
                                        root.current_color_pattern = s;
                                        root.view_patterns_changed(s, root.current_export_color_pattern);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Export-Farbmuster:"; color: #b0b0c4; vertical-alignment: center; }
                                ComboBox {
                                    width: 160px;
                                    model: ["None", "Original", "OriginalPlusZebra", "Zebra"];
                                    current-value: root.current_export_color_pattern;
                                    selected(s) => {
                                        root.current_export_color_pattern = s;
                                        root.view_patterns_changed(root.current_color_pattern, s);
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #333346; }

                        // Files in View header
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Zugeordnete Tabellendateien (Reihenfolge = Tabs im Hauptfenster):";
                                font-weight: 600;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "+ CSV / ODS hinzufügen";
                                    primary: true;
                                    clicked => { root.add_csv_to_view_clicked(); }
                                }
                                Button {
                                    text: "+ Ordner importieren";
                                    clicked => { root.add_folder_to_view_clicked(); }
                                }
                                Button {
                                    text: "Geöffnete Tabs übernehmen";
                                    clicked => { root.import_open_tabs_to_view_clicked(); }
                                }
                                Button {
                                    text: "➜ Alle in Basispfad verschieben";
                                    primary: true;
                                    enabled: root.current_view_files.length > 0;
                                    clicked => { root.relocate_all_info_files_clicked(); }
                                }
                            }
                        }

                        // Files Table Header
                        Rectangle {
                            height: 28px;
                            background: #252533;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;

                                Text { horizontal-stretch: 1; text: "Dateiname & Dateipfad"; font-weight: 600; color: #a5a5bb; vertical-alignment: center; }
                                Text { width: 110px; text: "Speichermodus"; font-weight: 600; color: #a5a5bb; vertical-alignment: center; }
                                Text { width: 125px; text: "Status"; font-weight: 600; color: #a5a5bb; vertical-alignment: center; }
                                Text { width: 340px; text: "Aktionen & Reihenfolge"; font-weight: 600; color: #a5a5bb; vertical-alignment: center; horizontal-alignment: right; }
                            }
                        }

                        // Files List
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                for f[f_idx] in root.current_view_files: Rectangle {
                                    height: 46px;
                                    background: root.selected_file_idx == f_idx ? #2d3b59 : #232330;
                                    border-radius: 4px;
                                    border-width: root.selected_file_idx == f_idx ? 1.5px : 1px;
                                    border-color: root.selected_file_idx == f_idx ? #60a5fa : #313145;

                                    TouchArea {
                                        width: parent.width - 350px;
                                        clicked => { root.selected_file_idx = f_idx; }
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        spacing: 10px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: "📄 " + f.file_name;
                                                font-weight: 600;
                                                font-size: 13px;
                                                color: #ffffff;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: f.relative_path;
                                                font-size: 11px;
                                                color: #94a3b8;
                                                overflow: elide;
                                            }
                                        }

                                        Text {
                                            width: 110px;
                                            text: f.storage_mode;
                                            color: #9fa8da;
                                            vertical-alignment: center;
                                        }

                                        // Status badge
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 125px;
                                                height: 24px;
                                                background: f.integrity_status == "Gültig" ? #1b382b : (f.can_relocate ? #451a03 : (f.integrity_status == "Info fehlt" ? #3e3215 : #3f1d1d));
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: f.integrity_status == "Gültig" ? #059669 : (f.can_relocate ? #d97706 : (f.integrity_status == "Info fehlt" ? #b45309 : #ef4444));
                                                Text {
                                                    text: f.integrity_status;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    color: f.integrity_status == "Gültig" ? #6ee7b7 : (f.can_relocate ? #fcd34d : (f.integrity_status == "Info fehlt" ? #ffb74d : #ef5350));
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Action buttons
                                        HorizontalLayout {
                                            width: 340px;
                                            spacing: 4px;
                                            alignment: end;

                                            Button {
                                                text: "⚙ .info";
                                                clicked => { root.open_info_editor_for_file_clicked(f_idx); }
                                            }
                                            Button {
                                                text: "Diff";
                                                clicked => { root.diff_info_file_clicked(f_idx); }
                                            }
                                            Button {
                                                text: root.selected_storage_mode == 0 ? (f.storage_mode == "KollektionsBasispfad" && !f.can_relocate ? "✓ Basispfad" : "➜ Basispfad") :
                                                      root.selected_storage_mode == 1 ? (f.storage_mode == "Dateipfad" ? "✓ Dateipfad" : "➜ Dateipfad") :
                                                      root.selected_storage_mode == 2 ? (f.storage_mode == "Stammverzeichnis" ? "✓ Stammverz." : "➜ Stammverz.") :
                                                      root.selected_storage_mode == 3 ? (f.storage_mode == "Temporaer" ? "✓ Temporär" : "➜ Temporär") :
                                                      (f.storage_mode == "BenutzerEntscheidet" ? "✓ Abfragen" : "➜ Abfragen");
                                                primary: f.can_relocate || (
                                                    root.selected_storage_mode == 0 ? (f.storage_mode != "KollektionsBasispfad" && f.storage_mode != "Standard") :
                                                    root.selected_storage_mode == 1 ? f.storage_mode != "Dateipfad" :
                                                    root.selected_storage_mode == 2 ? f.storage_mode != "Stammverzeichnis" :
                                                    root.selected_storage_mode == 3 ? f.storage_mode != "Temporaer" :
                                                    f.storage_mode != "BenutzerEntscheidet"
                                                );
                                                enabled: f.can_relocate || (
                                                    root.selected_storage_mode == 0 ? (f.storage_mode != "KollektionsBasispfad" || f.can_relocate) :
                                                    root.selected_storage_mode == 1 ? f.storage_mode != "Dateipfad" :
                                                    root.selected_storage_mode == 2 ? f.storage_mode != "Stammverzeichnis" :
                                                    root.selected_storage_mode == 3 ? f.storage_mode != "Temporaer" :
                                                    f.storage_mode != "BenutzerEntscheidet"
                                                );
                                                clicked => { root.migrate_info_file_clicked(f_idx); }
                                            }
                                            Button {
                                                text: "▲";
                                                enabled: f_idx > 0;
                                                clicked => { root.move_file_up(f_idx); }
                                            }
                                            Button {
                                                text: "▼";
                                                enabled: f_idx < root.current_view_files.length - 1;
                                                clicked => { root.move_file_down(f_idx); }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                ConfigDeleteButton {
                                                    clicked => { root.remove_file_from_view_clicked(f_idx); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Selected File Detailed Path Inspector
                        if root.selected_file_idx >= 0 && root.selected_file_idx < root.current_view_files.length: Rectangle {
                            background: #171720;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #313145;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 6px;

                                if root.current_view_files[root.selected_file_idx].can_relocate: Rectangle {
                                    background: #3a1c06;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: #d97706;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        padding-top: 8px;
                                        padding-bottom: 8px;
                                        spacing: 12px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "⚠️ Info-Datei folgt noch Option 2 (dezentral im Verzeichnis) und liegt nicht im Kollektions-Basispfad!";
                                                color: #fef08a;
                                                font-size: 11px;
                                                font-weight: 700;
                                            }
                                            Text {
                                                text: "Ziel im Basispfad: " + root.current_view_files[root.selected_file_idx].expected_info_path;
                                                color: #cbd5e1;
                                                font-size: 10px;
                                            }
                                        }

                                        Button {
                                            text: "In Kollektions-Basispfad verschieben";
                                            primary: true;
                                            clicked => { root.relocate_info_file_clicked(root.selected_file_idx); }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        width: 120px;
                                        text: "Vollständiger Pfad:";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #93c5fd;
                                        vertical-alignment: center;
                                    }
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        read-only: true;
                                        text: root.current_view_files[root.selected_file_idx].relative_path;
                                    }
                                }
                                if root.current_view_files[root.selected_file_idx].info_file_path != "": HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        width: 120px;
                                        text: "Info-Datei Pfad:";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #a78bfa;
                                        vertical-alignment: center;
                                    }
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        read-only: true;
                                        text: root.current_view_files[root.selected_file_idx].info_file_path;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // TAB 1: SPEICHERORTE & INFO-DATEIEN
            if root.active_nav_tab == 1: VerticalLayout {
                padding: 24px;
                spacing: 20px;

                Text {
                    text: "Globale Speichermodi für Konfigurationsdateien (*.csv.info)";
                    font-size: 15px;
                    font-weight: 700;
                    color: #ffffff;
                }

                Text {
                    text: "Bestimmt, wo das System beim Laden oder Speichern von CSV-Dateien nach der zugehörigen .info-Konfiguration sucht:";
                    color: #b0b0c2;
                }

                VerticalLayout {
                    spacing: 12px;

                    // Option 0: Kollektions-Basispfad (Standard)
                    Rectangle {
                        height: 60px;
                        background: root.selected_storage_mode == 0 ? #27344e : #1c1c25;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.selected_storage_mode == 0 ? #60a5fa : #36364a;

                        TouchArea { clicked => { root.selected_storage_mode = 0; root.storage_mode_changed(0); } }

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 14px;

                            CheckBox {
                                text: "";
                                checked: root.selected_storage_mode == 0;
                                toggled => { root.selected_storage_mode = 0; root.storage_mode_changed(0); }
                            }
                            VerticalLayout {
                                Text { text: "1. Kollektions-Basispfad (Standard)"; font-weight: 600; color: #ffffff; }
                                Text { text: "Die .csv.info-Datei wird im konfigurierten Basispfad der Kollektion gespeichert (Fallback: Dateipfad)."; font-size: 11px; color: #9c9cb2; }
                            }
                        }
                    }

                    // Option 1: Dateipfad (Dezentral)
                    Rectangle {
                        height: 60px;
                        background: root.selected_storage_mode == 1 ? #27344e : #1c1c25;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.selected_storage_mode == 1 ? #60a5fa : #36364a;

                        TouchArea { clicked => { root.selected_storage_mode = 1; root.storage_mode_changed(1); } }

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 14px;

                            CheckBox {
                                text: "";
                                checked: root.selected_storage_mode == 1;
                                toggled => { root.selected_storage_mode = 1; root.storage_mode_changed(1); }
                            }
                            VerticalLayout {
                                Text { text: "2. Dateipfad (Dezentral)"; font-weight: 600; color: #ffffff; }
                                Text { text: "Die .csv.info-Datei liegt immer direkt neben der CSV-Datei (z. B. switches.csv.info neben switches.csv)."; font-size: 11px; color: #9c9cb2; }
                            }
                        }
                    }

                    // Option 2: Stammverzeichnis (Zentral)
                    Rectangle {
                        height: 60px;
                        background: root.selected_storage_mode == 2 ? #27344e : #1c1c25;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.selected_storage_mode == 2 ? #60a5fa : #36364a;

                        TouchArea { clicked => { root.selected_storage_mode = 2; root.storage_mode_changed(2); } }

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 14px;

                            CheckBox {
                                text: "";
                                checked: root.selected_storage_mode == 2;
                                toggled => { root.selected_storage_mode = 2; root.storage_mode_changed(2); }
                            }
                            VerticalLayout {
                                Text { text: "3. Stammverzeichnis (Zentral)"; font-weight: 600; color: #ffffff; }
                                Text { text: "Alle .info-Dateien werden in einem zentralen Config-Verzeichnis gesammelt gespeichert."; font-size: 11px; color: #9c9cb2; }
                            }
                        }
                    }

                    // Option 3: Temporaer
                    Rectangle {
                        height: 60px;
                        background: root.selected_storage_mode == 3 ? #27344e : #1c1c25;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.selected_storage_mode == 3 ? #60a5fa : #36364a;

                        TouchArea { clicked => { root.selected_storage_mode = 3; root.storage_mode_changed(3); } }

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 14px;

                            CheckBox {
                                text: "";
                                checked: root.selected_storage_mode == 3;
                                toggled => { root.selected_storage_mode = 3; root.storage_mode_changed(3); }
                            }
                            VerticalLayout {
                                Text { text: "4. Temporär (Nur im Arbeitsspeicher)"; font-weight: 600; color: #ffffff; }
                                Text { text: "Änderungen an Mappings & Regeln gelten nur für die laufende Sitzung und werden nicht auf Platte persistiert."; font-size: 11px; color: #9c9cb2; }
                            }
                        }
                    }

                    // Option 4: BenutzerEntscheidet
                    Rectangle {
                        height: 60px;
                        background: root.selected_storage_mode == 4 ? #27344e : #1c1c25;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.selected_storage_mode == 4 ? #60a5fa : #36364a;

                        TouchArea { clicked => { root.selected_storage_mode = 4; root.storage_mode_changed(4); } }

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 14px;

                            CheckBox {
                                text: "";
                                checked: root.selected_storage_mode == 4;
                                toggled => { root.selected_storage_mode = 4; root.storage_mode_changed(4); }
                            }
                            VerticalLayout {
                                Text { text: "5. Interaktive Benutzerabfrage"; font-weight: 600; color: #ffffff; }
                                Text { text: "Beim Öffnen einer neuen CSV-Datei fragt das System interaktiv, wo die Konfiguration gespeichert werden soll."; font-size: 11px; color: #9c9cb2; }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: #333346; }

                // Central Directory Config
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Zentrales Konfigurationsverzeichnis (für Modus Stammverzeichnis):";
                        font-weight: 600;
                        color: #ffffff;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.central_directory_path;
                            edited(s) => {
                                root.central_directory_path = s;
                                root.central_directory_edited(s);
                            }
                        }
                        Button {
                            text: "Ordner auswählen...";
                            clicked => { root.browse_central_directory(); }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            // TAB 2: FARBKATALOG (BRUSHES)
            if root.active_nav_tab == 2: HorizontalLayout {
                padding: 14px;
                spacing: 14px;

                // Left: Brushes list & search
                Rectangle {
                    width: 480px;
                    background: #1b1b23;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #313142;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Farbkatalog (Brushes)";
                                font-weight: 600;
                                color: #ffffff;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text { text: "Priorität:"; color: #9c9cb2; vertical-alignment: center; }
                                LineEdit {
                                    width: 60px;
                                    text: root.marker_priority;
                                }
                            }
                        }

                        // Search
                        LineEdit {
                            placeholder-text: "Nach Name, Kategorie oder Hex filtern...";
                            text: root.brush_search_query;
                            edited(s) => {
                                root.brush_search_query = s;
                                root.brush_search_changed(s);
                            }
                        }

                        // Brushes List
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                for b[b_idx] in root.brushes: Rectangle {
                                    height: 36px;
                                    background: root.selected_brush_idx == b_idx ? #2d3b59 : #242431;
                                    border-radius: 4px;
                                    border-width: root.selected_brush_idx == b_idx ? 1px : 0px;
                                    border-color: #60a5fa;

                                    TouchArea {
                                        clicked => {
                                            root.selected_brush_idx = b_idx;
                                            root.brush_selected(b_idx);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 10px;

                                        // Color Preview Box
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 20px;
                                                height: 20px;
                                                background: b.color;
                                                border-radius: 3px;
                                                border-width: 1px;
                                                border-color: #ffffff44;
                                            }
                                        }

                                        Text {
                                            width: 170px;
                                            text: b.key;
                                            font-weight: 600;
                                            color: #ffffff;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            width: 80px;
                                            text: b.hex_value;
                                            color: #ffca28;
                                            font-family: "Consolas, Courier New, monospace";
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            horizontal-stretch: 1;
                                            text: b.category;
                                            color: #90caf9;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }

                                        if b.is_system: Text {
                                            text: "System";
                                            font-size: 10px;
                                            color: #7986cb;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Right: Edit / Add Brush pane
                Rectangle {
                    vertical-stretch: 1;
                    background: #1b1b23;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #313142;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text {
                            text: root.selected_brush_idx >= 0 ? "Farbdefinition bearbeiten" : "Neue Farbe hinzufügen";
                            font-size: 15px;
                            font-weight: 600;
                            color: #ffffff;
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Schlüsselname (Key):"; color: #b0b0c2; }
                            LineEdit {
                                text: root.edit_brush_key;
                                placeholder-text: "z.B. MarkerCyan oder AlertBrush";
                                enabled: !root.edit_brush_is_system;
                                edited(s) => { root.edit_brush_key = s; }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Hex-Farbwert (#RRGGBB):"; color: #b0b0c2; }
                            LineEdit {
                                text: root.edit_brush_hex;
                                placeholder-text: "#FF5722";
                                edited(s) => { root.edit_brush_hex = s; }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Kategorie (UI, Status, Textmarker, Analyse, Logging):"; color: #b0b0c2; }
                            LineEdit {
                                text: root.edit_brush_category;
                                edited(s) => { root.edit_brush_category = s; }
                            }
                        }

                        // Quick palette buttons
                        Text { text: "Schnellauswahl-Palette:"; font-size: 11px; color: #8e8ea6; }
                        HorizontalLayout {
                            spacing: 6px;
                            Button { text: "Rot"; clicked => { root.edit_brush_hex = "#ef5350"; } }
                            Button { text: "Grün"; clicked => { root.edit_brush_hex = "#66bb6a"; } }
                            Button { text: "Gelb"; clicked => { root.edit_brush_hex = "#fff59d"; } }
                            Button { text: "Blau"; clicked => { root.edit_brush_hex = "#42a5f5"; } }
                            Button { text: "Orange"; clicked => { root.edit_brush_hex = "#ffa726"; } }
                            Button { text: "Lila"; clicked => { root.edit_brush_hex = "#ab47bc"; } }
                        }

                        Rectangle { vertical-stretch: 1; }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            if root.selected_brush_idx >= 0 && !root.edit_brush_is_system: Button {
                                text: "Farbe löschen";
                                clicked => { root.delete_brush_clicked(root.edit_brush_key); }
                            }

                            Button {
                                text: "+ Neu anlegen";
                                clicked => {
                                    root.add_brush_clicked(root.edit_brush_key, root.edit_brush_hex, root.edit_brush_category);
                                }
                            }

                            Button {
                                text: "Übernehmen";
                                primary: true;
                                clicked => {
                                    root.update_brush_clicked(root.edit_brush_key, root.edit_brush_hex, root.edit_brush_category);
                                }
                            }
                        }
                    }
                }
            }

            // TAB 3: DATEIVERKNÜPFUNGEN
            if root.active_nav_tab == 3: VerticalLayout {
                padding: 24px;
                spacing: 20px;

                Text {
                    text: "Betriebssystem-Dateiverknüpfungen (Windows Shell Association)";
                    font-size: 15px;
                    font-weight: 700;
                    color: #ffffff;
                }

                Text {
                    text: "Ermöglicht das Öffnen von CSV- und .info-Dateien direkt per Doppelklick im Windows Explorer.";
                    color: #b0b0c2;
                }

                Rectangle {
                    height: 80px;
                    background: #1c1c25;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #36364a;

                    HorizontalLayout {
                        padding: 16px;
                        spacing: 16px;

                        CheckBox {
                            text: "Beim Start automatisch prüfen, ob Dateiendungen (.csv, .csv.info) verknüpft sind";
                            checked: root.check_associations_on_startup;
                            toggled => {
                                root.check_associations_on_startup = self.checked;
                                root.toggle_associations_startup(self.checked);
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    Button {
                        text: "🔗 Dateiverknüpfungen jetzt im Betriebssystem registrieren";
                        primary: true;
                        clicked => { root.register_associations_now(); }
                    }

                    Text {
                        text: root.association_status_message;
                        color: #64b5f6;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            // TAB 4: EXTERNE PROGRAMME ("ÖFFNEN MIT")
            if root.active_nav_tab == 4: HorizontalLayout {
                padding: 14px;
                spacing: 14px;

                // Left: List of Apps
                Rectangle {
                    width: 480px;
                    background: #1b1b23;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #313142;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "🚀 Externe Programme ('Öffnen mit')";
                                font-weight: 600;
                                color: #ffffff;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Button {
                                    text: "▲";
                                    enabled: root.selected_app_idx > 0;
                                    clicked => { root.move_app_up(root.selected_app_idx); }
                                }
                                Button {
                                    text: "▼";
                                    enabled: root.selected_app_idx >= 0 && root.selected_app_idx < root.external_apps.length - 1;
                                    clicked => { root.move_app_down(root.selected_app_idx); }
                                }
                            }
                        }

                        Text {
                            text: "Wählen Sie ein Programm zum Bearbeiten aus:";
                            font-size: 11px;
                            color: #9c9cb2;
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                for app[app_idx] in root.external_apps: Rectangle {
                                    height: 48px;
                                    border-radius: 5px;
                                    background: root.selected_app_idx == app_idx ? #2c324a : (app_touch.has-hover ? #252838 : #1f202b);
                                    border-width: 1px;
                                    border-color: root.selected_app_idx == app_idx ? #4f68d2 : #2f3244;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: app.name;
                                                color: root.selected_app_idx == app_idx ? #ffffff : #e2e8f0;
                                                font-weight: 600;
                                                font-size: 13px;
                                            }
                                            Text {
                                                text: app.command_or_path != "" ? app.command_or_path : "(Standardpfad)";
                                                color: #94a3b8;
                                                font-size: 10px;
                                                overflow: elide;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: center;
                                            ConfigDeleteButton {
                                                clicked => { root.delete_app_clicked(app_idx); }
                                            }
                                        }
                                    }

                                    app_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select_app(app_idx); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Right: Editor Panel for Add / Update
                Rectangle {
                    horizontal-stretch: 1;
                    background: #1b1b23;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #313142;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: root.selected_app_idx >= 0 ? "Programmdetails bearbeiten" : "Neues externes Programm hinzufügen";
                            font-size: 14px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Name / Bezeichnung:"; color: #9c9cb2; font-size: 11px; }
                            LineEdit {
                                placeholder-text: "z.B. Notepad++, LibreOffice, VS Code";
                                text: root.edit_app_name;
                                edited(s) => { root.edit_app_name = s; }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Ausführbare Datei / Befehl:"; color: #9c9cb2; font-size: 11px; }
                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    placeholder-text: "Pfad zu .exe oder Befehl im PATH";
                                    text: root.edit_app_path;
                                    edited(s) => { root.edit_app_path = s; }
                                }
                                Button {
                                    text: "📁 Durchsuchen...";
                                    clicked => { root.browse_app_path_clicked(); }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Optionale Parameter / Argumente (z.B. {file}):"; color: #9c9cb2; font-size: 11px; }
                            LineEdit {
                                placeholder-text: "Leer lassen für Standard (Dateipfad anhängen) oder z.B. -multiInst {file}";
                                text: root.edit_app_arguments;
                                edited(s) => { root.edit_app_arguments = s; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Button {
                                text: "✓ Aktualisieren";
                                primary: true;
                                enabled: root.selected_app_idx >= 0 && root.edit_app_name != "";
                                clicked => {
                                    root.update_app_clicked(root.selected_app_idx, root.edit_app_name, root.edit_app_path, root.edit_app_arguments);
                                }
                            }
                            Button {
                                text: "+ Als neu hinzufügen";
                                enabled: root.edit_app_name != "";
                                clicked => {
                                    root.add_app_clicked(root.edit_app_name, root.edit_app_path, root.edit_app_arguments);
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: #2a2a3a;
                        }

                        Text {
                            text: "Hinweis: LibreOffice und Notepad++ sind als Standardprogramme vorkonfiguriert. Über das Schnellstartmenü '🚀 Öffnen mit' in der Hauptansicht können geöffnete Tabellen direkt an diese Programme übergeben werden.";
                            color: #8b8ba0;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        // BOTTOM ACTION BAR
        Rectangle {
            height: 48px;
            background: #252530;
            border-radius: 8px;
            border-width: 1px;
            border-color: #38384a;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                alignment: end;

                Button {
                    text: "Abbrechen";
                    clicked => { root.cancel_clicked(); }
                }

                Button {
                    text: "✓ Speichern & Kollektion laden";
                    primary: true;
                    clicked => { root.save_and_close_clicked(); }
                }
            }
        }
    }

    // DIFF MODAL
    if root.diff_modal_visible: Rectangle {
        background: #000000bb;
        x: 0px; y: 0px; width: parent.width; height: parent.height;

        Rectangle {
            width: 650px;
            height: 480px;
            background: #252530;
            border-radius: 8px;
            border-width: 1px;
            border-color: #444458;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: "Info-Dateien Vergleich (Diff)";
                    font-size: 16px;
                    font-weight: 700;
                    color: #ffffff;
                }

                ScrollView {
                    vertical-stretch: 1;
                    Text {
                        text: root.diff_modal_text;
                        color: #d1d1de;
                        font-family: "Consolas, Courier New, monospace";
                        font-size: 12px;
                    }
                }

                Button {
                    text: "Schließen";
                    clicked => { root.close_diff_modal(); }
                }
            }
        }
    }

    // RENAME COLLECTION MODAL
    if root.rename_modal_visible: Rectangle {
        background: #000000bb;
        x: 0px; y: 0px; width: parent.width; height: parent.height;

        TouchArea {
            // Absorb background clicks
        }

        Rectangle {
            width: 460px;
            height: 195px;
            background: #252530;
            border-radius: 8px;
            border-width: 1px;
            border-color: #444458;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: "🏷️ Kollektion umbenennen";
                    font-size: 16px;
                    font-weight: 700;
                    color: #ffffff;
                }

                Text {
                    text: "Neuen Namen für die ausgewählte Kollektion eingeben:";
                    color: #9fa8da;
                    font-size: 12px;
                }

                LineEdit {
                    text <=> root.rename_modal_input;
                    placeholder-text: "Name der Kollektion...";
                    accepted => {
                        if root.rename_modal_input != "" {
                            root.confirm_rename_modal(root.rename_modal_input);
                            root.rename_modal_visible = false;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Button {
                        text: "Abbrechen";
                        clicked => {
                            root.rename_modal_visible = false;
                        }
                    }

                    Button {
                        text: "✓ Umbenennen";
                        primary: true;
                        enabled: root.rename_modal_input != "";
                        clicked => {
                            root.confirm_rename_modal(root.rename_modal_input);
                            root.rename_modal_visible = false;
                        }
                    }
                }
            }
        }
    }
}
