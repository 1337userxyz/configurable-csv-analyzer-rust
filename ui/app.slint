export struct TabItem {
    id: string,
    title: string,
    is_dirty: bool,
    error_count: int,
    is_active: bool,
    is_ods: bool,
    file_type: string,
    tab_index: int,
    total_tabs: int,
}

export struct TabRowItem {
    tabs: [TabItem],
}

export struct SlintCollectionTabGroup {
    name: string,
    is_temporary: bool,
    tab_count: int,
    tabs: [TabItem],
    tab_rows: [TabRowItem],
}

export struct HeaderItem {
    id: int,
    name: string,
    concept: string,
    sort_dir: int, // 0 = none, 1 = asc, 2 = desc
    is_filtered: bool,
    width: length,
}

export struct CellItem {
    text: string,
    bg_color: color,
    has_error: bool,
    has_warning: bool,
    has_info: bool,
}

export struct RowItem {
    row_idx: int,
    original_idx: int,
    is_marked: bool,
    bg_color: color,
    cells: [CellItem],
}

export struct RuleSummaryItem {
    id: string,
    description: string,
    hits: int,
    errors: int,
    warnings: int,
}

export struct ProposalItem {
    source_table: string,
    key_val: string,
    preview: string,
    row_idx: int,
}

export struct LogViewItem {
    timestamp: string,
    level: string,
    message: string,
}

export struct FilterChoiceItem {
    value: string,
    display_text: string,
    count: int,
    selected: bool,
    visible: bool,
}

export struct SmartAddSuggestionItem {
    value: string,
    display: string,
    count: int,
    is_load_more: bool,
}

export struct SmartAddFieldItem {
    col_idx: int,
    column_name: string,
    concept_name: string,
    value: string,
    suggestions: [SmartAddSuggestionItem],
    dropdown_open: bool,
}

component ModernScrollBar inherits Rectangle {
    in-out property <length> content_x: 0px;
    in property <length> viewport_width: 1000px;
    in property <length> visible_width: 500px;

    height: 6px;
    background: #181c28;
    border-radius: 3px;
    border-width: 1px;
    border-color: #262f44;

    property <length> max_scroll: max(1px, root.viewport_width - root.visible_width);
    property <length> track_w: root.width;
    property <length> thumb_w: max(32px, (root.visible_width / max(1px, root.viewport_width)) * root.track_w);
    property <length> travel: max(1px, root.track_w - root.thumb_w);

    if root.viewport_width > root.visible_width: Rectangle {
        x: min(root.travel, max(0px, (-root.content_x / root.max_scroll) * root.travel));
        width: root.thumb_w;
        height: 6px;
        border-radius: 3px;
        background: thumb_touch.has-hover ? #60a5fa : #3b82f6;

        thumb_touch := TouchArea {
            mouse-cursor: pointer;
            moved => {
                if self.pressed {
                    let rel = (self.mouse-x + parent.x) / max(1px, root.track_w);
                    let clamped = min(1.0, max(0.0, rel));
                    root.content_x = -clamped * root.max_scroll;
                }
            }
        }
    }
}

component SingleTab inherits Rectangle {
    in property <TabItem> tab;
    in property <int> tab_idx: 0;
    in property <int> total_tabs: 0;
    in property <bool> full_title: false;
    callback selected(string);
    callback move_left(string);
    callback move_right(string);
    callback move_to_collection_clicked(string);
    callback close_clicked(string);
    callback commit_edit();

    min-width: 140px;
    max-width: full_title ? 10000px : 380px;
    min-height: 34px;
    background: root.tab.is_active ? #223a66 : (tab_touch.has-hover ? #252d42 : #1b2132);
    border-radius: 6px;
    border-width: root.tab.is_active ? 1.5px : 1px;
    border-color: root.tab.is_active ? #60a5fa : (tab_touch.has-hover ? #47557a : #333d54);

    // Active top indicator stripe
    if root.tab.is_active: Rectangle {
        y: 0px;
        height: 3px;
        width: parent.width - 8px;
        x: 4px;
        border-radius: 1.5px;
        background: #60a5fa;
    }

    tab_touch := TouchArea {
        width: parent.width - 88px;
        clicked => {
            root.commit_edit();
            root.selected(root.tab.id);
        }
        moved => {
            if self.pressed && self.mouse-x < -25px {
                root.move_left(root.tab.id);
            }
            if self.pressed && self.mouse-x > (parent.width + 15px) {
                root.move_right(root.tab.id);
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 6px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 5px;
            alignment: start;
            horizontal-stretch: 1;

            // Mode badge [CSV] / [ODS]
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 28px;
                    height: 16px;
                    border-radius: 3px;
                    background: root.tab.is_ods ? #451a03 : #064e3b;
                    border-width: 1px;
                    border-color: root.tab.is_ods ? #b45309 : #059669;
                    Text {
                        text: root.tab.is_ods ? "ODS" : "CSV";
                        color: root.tab.is_ods ? #fcd34d : #6ee7b7;
                        font-size: 9px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;

                Text {
                    text: root.tab.title;
                    color: root.tab.is_active ? #ffffff : (tab_touch.has-hover ? #e2e8f0 : #b4bed4);
                    font-weight: root.tab.is_active ? 700 : 500;
                    font-size: 11px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
            if root.tab.is_dirty: Text {
                text: "*";
                color: #fbbf24;
                font-weight: 700;
                font-size: 14px;
                vertical-alignment: center;
            }
            if root.tab.error_count > 0: VerticalLayout {
                alignment: center;
                Rectangle {
                    min-width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: #ef4444;
                    Text {
                        text: root.tab.error_count;
                        color: #ffffff;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 2px;
            alignment: end;

            // Move Left (◀)
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 4px;
                    background: (root.tab.tab_index > 0 || root.tab_idx > 0) && tab_left_hover.has-hover ? #3b82f6 : (root.tab.is_active ? #2d3e61 : #22283a);
                    opacity: (root.tab.tab_index > 0 || root.tab_idx > 0) ? 1.0 : 0.35;
                    Text {
                        text: "◀";
                        color: tab_left_hover.has-hover ? #ffffff : #cbd5e1;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    tab_left_hover := TouchArea {
                        mouse-cursor: (root.tab.tab_index > 0 || root.tab_idx > 0) ? pointer : default;
                        clicked => {
                            if (root.tab.tab_index > 0 || root.tab_idx > 0) {
                                root.move_left(root.tab.id);
                            }
                        }
                    }
                }
            }

            // Move Right (▶)
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 4px;
                    background: ((root.tab.total_tabs > 0 && root.tab.tab_index < root.tab.total_tabs - 1) || (root.total_tabs > 0 && root.tab_idx < root.total_tabs - 1)) && tab_right_hover.has-hover ? #3b82f6 : (root.tab.is_active ? #2d3e61 : #22283a);
                    opacity: ((root.tab.total_tabs > 0 && root.tab.tab_index < root.tab.total_tabs - 1) || (root.total_tabs > 0 && root.tab_idx < root.total_tabs - 1)) ? 1.0 : 0.35;
                    Text {
                        text: "▶";
                        color: tab_right_hover.has-hover ? #ffffff : #cbd5e1;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    tab_right_hover := TouchArea {
                        mouse-cursor: ((root.tab.total_tabs > 0 && root.tab.tab_index < root.tab.total_tabs - 1) || (root.total_tabs > 0 && root.tab_idx < root.total_tabs - 1)) ? pointer : default;
                        clicked => {
                            if ((root.tab.total_tabs > 0 && root.tab.tab_index < root.tab.total_tabs - 1) || (root.total_tabs > 0 && root.tab_idx < root.total_tabs - 1)) {
                                root.move_right(root.tab.id);
                            }
                        }
                    }
                }
            }

            // Move to another collection (⇄)
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 4px;
                    background: tab_move_col_hover.has-hover ? #8b5cf6 : (root.tab.is_active ? #2d3e61 : #22283a);
                    Text {
                        text: "⇄";
                        color: tab_move_col_hover.has-hover ? #ffffff : #c4b5fd;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    tab_move_col_hover := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.move_to_collection_clicked(root.tab.id); }
                    }
                }
            }

            // Close Tab (✕)
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: tab_close_hover.has-hover ? #ef4444 : (root.tab.is_active ? #384b73 : #283044);
                    Text {
                        text: "✕";
                        color: tab_close_hover.has-hover ? #ffffff : (root.tab.is_active ? #cbd5e1 : #8893a7);
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    tab_close_hover := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close_clicked(root.tab.id); }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Configurable CSV & ODS Analyzer";
    min-width: 1100px;
    min-height: 720px;
    background: #1e1e24;
    default-font-family: "Segoe UI, Inter, Roboto, sans-serif";
    default-font-size: 13px;

    // Callbacks from Slint to Rust
    callback open_csv_clicked();
    callback open_ods_clicked();
    callback open_folder_clicked();
    callback save_clicked();
    callback save_as_clicked();
    callback revert_clicked();
    callback open_libreoffice_clicked();
    callback open_with_app_clicked(int);
    callback export_csv_to_ods_clicked();
    callback export_ods_to_csv_clicked();
    callback view_mode_changed(int);

    callback tab_selected(string);
    callback tab_close_clicked(string);
    callback tab_move_left(string);
    callback tab_move_right(string);
    callback view_selected(string);
    callback collection_single_clicked(string);
    callback collection_toggled(string, bool);
    callback collection_clear_filter();

    callback select_all_toggled(bool);
    callback only_marked_toggled(bool);
    callback mark_empty_rows_clicked();
    callback clear_selection_clicked();
    callback row_mark_toggled(int, bool);

    callback apply_marker_color(string);
    callback clear_markers_clicked();

    callback search_text_changed(string);
    callback run_rules_clicked();

    callback header_sort_clicked(int);
    callback column_resized(int, length);
    callback open_filter_popup(int);
    callback filter_apply_clicked(int);
    callback filter_clear_all_clicked();
    callback filter_toggle_item(int, bool);
    callback filter_search_changed(string);
    callback filter_select_all(bool);
    callback filter_reset_column(int);

    callback cell_edited(int, int, string);

    callback show_fill_dialog_clicked();
    callback apply_fill_column(int, int, string, string, string, int, int);

    callback show_split_dialog_clicked();
    callback apply_split_column(int, string, string);

    callback smart_add_row_clicked();
    callback smart_add_field_edited(int, string);
    callback smart_add_toggle_dropdown(int);
    callback smart_add_suggestion_selected(int, int);
    callback smart_add_clear_all_fields();
    callback confirm_smart_add_rows(int);

    callback delete_marked_rows_clicked();

    callback show_ods_sheet_dialog_clicked();
    callback select_ods_sheet_clicked(string);

    callback show_info_editor_clicked();
    callback save_info_editor_clicked(string, string);
    callback show_config_clicked();

    callback show_diff_dialog_clicked();
    callback sync_diff_clicked();

    callback copy_clipboard_clicked();
    callback paste_clipboard_clicked();

    callback dock_tab_selected(int);
    callback toggle_dock_collapsed();
    callback copy_logs_clicked();
    callback proposal_apply_clicked(int);

    callback toggle_tabs_multiline();
    callback show_save_collection_dialog();
    callback save_collection_confirmed(string);
    callback open_move_table_dialog(string);
    callback move_modal_target_changed(string);
    callback confirm_move_table(string, string, bool);

    // Properties exposed to Rust
    in-out property <[SlintCollectionTabGroup]> collection_groups: [];
    in-out property <bool> move_modal_visible: false;
    in-out property <string> move_modal_table_id: "";
    in-out property <string> move_modal_table_name: "";
    in-out property <string> move_modal_src_collection: "";
    in-out property <string> move_modal_target_collection: "";
    in-out property <[string]> move_modal_available_targets: [];
    in-out property <bool> move_modal_has_target_base_path: false;
    in-out property <string> move_modal_target_base_path: "";
    in-out property <bool> move_modal_move_physical_file: false;

    in-out property <[TabItem]> tabs: [];
    in-out property <[TabItem]> csv_tabs: [];
    in-out property <[TabItem]> ods_tabs: [];
    in-out property <bool> tabs_multiline: false;
    in-out property <[TabRowItem]> csv_tab_rows: [];
    in-out property <[TabRowItem]> ods_tab_rows: [];
    in-out property <bool> has_temporary_collection: false;
    in-out property <bool> save_collection_dialog_visible: false;
    in-out property <string> save_collection_name_input: "";
    in-out property <length> csv_tab_scroll_x: 0px;
    in-out property <length> ods_tab_scroll_x: 0px;
    in-out property <string> active_tab_id: "";
    in-out property <[string]> available_views: [];
    in-out property <string> active_view_name: "";
    in-out property <int> active_view_mode: 0; // 0: Alle, 1: CSV, 2: ODS
    in-out property <string> active_mode_label: "Alle";
    in-out property <int> csv_tab_count: 0;
    in-out property <int> ods_tab_count: 0;
    in-out property <bool> active_table_is_ods: false;
    in-out property <string> active_table_name: "";
    in-out property <length> tab_scroll_x: 0px;
    in-out property <length> tab_bar_custom_height: 0px;
    property <length> tab_bar_computed_height: root.collection_groups.length > 0 ? (
        root.tabs_multiline ? min(480px, max(84px, root.collection_groups.length * 110px)) : min(350px, max(76px, root.collection_groups.length * 74px + 12px))
    ) : (
        root.tabs_multiline ? (
            ((root.active_view_mode == 0 || root.active_view_mode == 1) && (root.csv_tabs.length > 0 || root.active_view_mode == 1) ? min(320px, max(72px, root.csv_tab_rows.length * 48px + 16px)) : 0px)
            + ((root.active_view_mode == 0 && root.ods_tabs.length > 0) || root.active_view_mode == 2 ? min(320px, max(72px, root.ods_tab_rows.length * 48px + 16px)) : 0px)
            + ((root.active_view_mode == 0 && root.csv_tabs.length > 0 && root.ods_tabs.length > 0) ? 1px : 0px)
        ) : ((root.active_view_mode == 0 && root.ods_tabs.length > 0 && root.csv_tabs.length > 0) ? 148px : 74px)
    );
    property <length> tab_bar_effective_height: root.tab_bar_custom_height > 0px ? root.tab_bar_custom_height : root.tab_bar_computed_height;
    in-out property <bool> all_tables_popup_open: false;
    in-out property <[HeaderItem]> headers: [];
    in-out property <[RowItem]> rows: [];
    in-out property <int> total_row_count: 0;
    in-out property <int> marked_row_count: 0;
    in-out property <bool> only_marked_active: false;
    in-out property <string> search_query: "";
    in-out property <string> status_message: "Bereit";

    // Marker Menu properties
    in-out property <bool> marker_menu_visible: false;
    in-out property <bool> open_menu_visible: false;
    in-out property <bool> open_with_menu_visible: false;
    in-out property <bool> export_sync_menu_visible: false;
    in-out property <bool> collection_menu_visible: false;
    in-out property <[SlintCollectionFilterItem]> collection_items: [];
    in-out property <string> collection_filter_summary: "Alle";
    in-out property <[SlintExternalAppItem]> external_apps: [];
    in-out property <[ColorChoiceItem]> marker_choices: [
        { key: "Gelb", hex_value: "#fff59d", color: #fff59d },
        { key: "Grün", hex_value: "#c8e6c9", color: #c8e6c9 },
        { key: "Blau", hex_value: "#bbdefb", color: #bbdefb },
        { key: "Rot", hex_value: "#ffcdd2", color: #ffcdd2 },
        { key: "Orange", hex_value: "#ffe0b2", color: #ffe0b2 },
        { key: "Lila", hex_value: "#e1bee7", color: #e1bee7 },
    ];

    // Dock properties
    in-out property <bool> dock_collapsed: false;
    in-out property <int> dock_tab_idx: 0; // 0: Rules, 1: Proposals, 2: Logs
    in-out property <[RuleSummaryItem]> rule_summaries: [];
    in-out property <[ProposalItem]> proposals: [];
    in-out property <[LogViewItem]> logs: [];

    // Filter modal
    in-out property <bool> filter_dialog_visible: false;
    in-out property <int> filter_dialog_col_idx: 0;
    in-out property <string> filter_dialog_col_name: "";
    in-out property <[FilterChoiceItem]> filter_dialog_items: [];
    in-out property <string> filter_dialog_search: "";
    in-out property <int> filter_dialog_total_hits: 0;

    // Smart Add Modal
    in-out property <bool> smart_add_dialog_visible: false;
    in-out property <string> smart_add_basis_text: "";
    in-out property <int> smart_add_row_count: 1;
    in-out property <string> smart_add_row_count_text: "1";
    in-out property <[SmartAddFieldItem]> smart_add_fields: [];

    // Fill Column Modal
    in-out property <bool> fill_dialog_visible: false;
    in-out property <int> fill_dialog_col_idx: 0;
    in-out property <int> fill_dialog_mode: 0; // 0: Static, 1: Prefix/Suffix, 2: Increment
    in-out property <string> fill_static_val: "";
    in-out property <string> fill_prefix_val: "";
    in-out property <string> fill_suffix_val: "";
    in-out property <int> fill_start_val: 1;
    in-out property <int> fill_step_val: 1;

    // Split Column Modal
    in-out property <bool> split_dialog_visible: false;
    in-out property <int> split_dialog_col_idx: 0;
    in-out property <string> split_delimiter: ",";
    in-out property <string> split_new_cols: "Spalte_1, Spalte_2";

    // Sheet Modal
    in-out property <bool> sheet_dialog_visible: false;
    in-out property <[string]> available_sheets: [];

    // Diff Modal
    in-out property <bool> diff_dialog_visible: false;
    in-out property <string> diff_summary_text: "";
    in-out property <string> diff_details_text: "";

    // Inline cell edit tracking
    in-out property <int> editing_row: -1;
    in-out property <int> editing_col: -1;
    in-out property <string> editing_text: "";
    in-out property <bool> editing_dirty: false;

    function commit_active_edit() {
        if (root.editing_row >= 0 && root.editing_col >= 0 && root.editing_dirty) {
            root.cell_edited(root.editing_row, root.editing_col, root.editing_text);
        }
        root.editing_row = -1;
        root.editing_col = -1;
        root.editing_dirty = false;
    }

    function set_smart_row_count(new_count: int) {
        let clamped = max(1, new_count);
        root.smart_add_row_count = clamped;
        root.smart_add_row_count_text = "" + clamped;
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ROW 1: FILE OPERATIONS & EXPORT & CONFIG
        Rectangle {
            height: 42px;
            background: #25252d;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Button {
                        text: "📂 Öffnen ▾";
                        clicked => {
                            root.commit_active_edit();
                            root.open_menu_visible = !root.open_menu_visible;
                            root.open_with_menu_visible = false;
                            root.export_sync_menu_visible = false;
                            root.collection_menu_visible = false;
                        }
                    }
                    Button {
                        text: "Speichern";
                        primary: true;
                        clicked => {
                            root.commit_active_edit();
                            root.save_clicked();
                        }
                    }
                    Button {
                        text: "Revert";
                        clicked => {
                            root.commit_active_edit();
                            root.revert_clicked();
                        }
                    }
                    Button {
                        text: "🚀 Öffnen mit ▾";
                        clicked => {
                            root.commit_active_edit();
                            root.open_with_menu_visible = !root.open_with_menu_visible;
                            root.open_menu_visible = false;
                            root.export_sync_menu_visible = false;
                            root.collection_menu_visible = false;
                        }
                    }

                    Rectangle { width: 1px; background: #444452; height: 24px; }

                    Button {
                        text: "🔄 Export & Sync ▾";
                        clicked => {
                            root.commit_active_edit();
                            root.export_sync_menu_visible = !root.export_sync_menu_visible;
                            root.open_menu_visible = false;
                            root.open_with_menu_visible = false;
                            root.collection_menu_visible = false;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;

                    Button {
                        text: "⚙ Konfiguration";
                        clicked => {
                            root.commit_active_edit();
                            root.show_config_clicked();
                        }
                    }
                    Button {
                        text: ".info Editor";
                        clicked => {
                            root.commit_active_edit();
                            root.show_info_editor_clicked();
                        }
                    }
                    Button {
                        text: "Kopieren (TSV)";
                        clicked => {
                            root.commit_active_edit();
                            root.copy_clipboard_clicked();
                        }
                    }
                    Button {
                        text: "Einfügen";
                        clicked => {
                            root.commit_active_edit();
                            root.paste_clipboard_clicked();
                        }
                    }
                }
            }
        }

        // ROW 2: KOLLEKTION & MODUS-UMSCHALTER & BEARBEITEN
        Rectangle {
            height: 42px;
            background: #1c1c24;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    if root.collection_items.length > 0: HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Button {
                            text: "📁 Kollektionen (" + root.collection_filter_summary + ") ▾";
                            clicked => {
                                root.commit_active_edit();
                                root.collection_menu_visible = !root.collection_menu_visible;
                                root.open_menu_visible = false;
                                root.open_with_menu_visible = false;
                                root.export_sync_menu_visible = false;
                            }
                        }

                        // Inline collection pills with checkboxes & direct-click
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            for col in root.collection_items: Rectangle {
                                height: 28px;
                                border-radius: 5px;
                                background: col.is_temporary ? (col.is_selected ? #451a03 : (col_touch.has-hover ? #2e1a06 : #1f1406)) : (col.is_selected ? #1e293b : (col_touch.has-hover ? #1f2233 : #151824));
                                border-width: 1px;
                                border-color: col.is_temporary ? (col.is_selected ? #f59e0b : #b45309) : (col.is_selected ? #3b82f6 : (col_touch.has-hover ? #475569 : #2e354a));

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 6px;
                                    alignment: center;

                                    CheckBox {
                                        checked: col.is_selected;
                                        toggled => {
                                            root.commit_active_edit();
                                            root.collection_toggled(col.name, self.checked);
                                        }
                                    }

                                    Rectangle {
                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: center;
                                            if col.is_temporary: Text {
                                                text: "⚡";
                                                font-size: 10px;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: col.name;
                                                color: col.is_temporary ? (col.is_selected ? #fbbf24 : #fcd34d) : (col.is_selected ? #60a5fa : #94a3b8);
                                                font-weight: col.is_selected ? 700 : 500;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                height: 16px;
                                                border-radius: 8px;
                                                background: col.is_temporary ? (col.is_selected ? #78350f : #451a03) : (col.is_selected ? #1d3557 : #0f172a);
                                                HorizontalLayout {
                                                    padding-left: 5px;
                                                    padding-right: 5px;
                                                    Text {
                                                        text: "" + col.file_count;
                                                        font-size: 9px;
                                                        font-weight: 600;
                                                        color: col.is_temporary ? #fef08a : (col.is_selected ? #93c5fd : #64748b);
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                        col_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.commit_active_edit();
                                                root.collection_single_clicked(col.name);
                                            }
                                        }
                                    }
                                }
                            }

                            if root.has_temporary_collection: Rectangle {
                                height: 28px;
                                border-radius: 5px;
                                background: save_temp_touch.has-hover ? #059669 : #065f46;
                                border-width: 1px;
                                border-color: #10b981;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;
                                    Text { text: "💾"; font-size: 11px; vertical-alignment: center; }
                                    Text {
                                        text: "Als Kollektion speichern";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                                save_temp_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.commit_active_edit();
                                        root.show_save_collection_dialog();
                                    }
                                }
                            }
                        }

                        Rectangle {
                            width: 1px;
                            height: 22px;
                            background: #2e3044;
                        }
                    }

                    // Mode Switcher Pill
                    HorizontalLayout {
                        spacing: 2px;
                        alignment: center;

                        Rectangle {
                            height: 30px;
                            background: #13141c;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #2e3044;

                            HorizontalLayout {
                                padding: 2px;
                                spacing: 3px;

                                // 0: Alle
                                Rectangle {
                                    width: 72px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: root.active_view_mode == 0 ? #2563eb : (m_all.has-hover ? #222638 : transparent);
                                    Text {
                                        text: "🗂 Alle (" + (root.csv_tab_count + root.ods_tab_count) + ")";
                                        font-size: 11px;
                                        font-weight: root.active_view_mode == 0 ? 700 : 500;
                                        color: root.active_view_mode == 0 ? #ffffff : #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    m_all := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.view_mode_changed(0); }
                                    }
                                }

                                // 1: CSV
                                Rectangle {
                                    width: 76px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: root.active_view_mode == 1 ? #059669 : (m_csv.has-hover ? #143526 : transparent);
                                    Text {
                                        text: "📄 CSV (" + root.csv_tab_count + ")";
                                        font-size: 11px;
                                        font-weight: root.active_view_mode == 1 ? 700 : 500;
                                        color: root.active_view_mode == 1 ? #ffffff : #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    m_csv := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.view_mode_changed(1); }
                                    }
                                }

                                // 2: ODS
                                Rectangle {
                                    width: 76px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: root.active_view_mode == 2 ? #d97706 : (m_ods.has-hover ? #382713 : transparent);
                                    Text {
                                        text: "📊 ODS (" + root.ods_tab_count + ")";
                                        font-size: 11px;
                                        font-weight: root.active_view_mode == 2 ? 700 : 500;
                                        color: root.active_view_mode == 2 ? #ffffff : #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    m_ods := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.view_mode_changed(2); }
                                    }
                                }
                            }
                        }
                    }

                    // Level Badge
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: root.active_table_is_ods ? #451a03 : #064e3b;
                        border-width: 1px;
                        border-color: root.active_table_is_ods ? #d97706 : #059669;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.active_table_is_ods ? "📊 ODS-Ebene" : "📄 CSV-Ebene";
                                color: root.active_table_is_ods ? #fcd34d : #6ee7b7;
                                font-weight: 700;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;

                    Button {
                        text: "🖍 Marker ▼";
                        clicked => {
                            root.commit_active_edit();
                            root.marker_menu_visible = !root.marker_menu_visible;
                        }
                    }
                    Button {
                        text: "+ Zeile (Smart)";
                        clicked => {
                            root.commit_active_edit();
                            root.smart_add_row_clicked();
                        }
                    }
                    Button {
                        text: "Spalte füllen";
                        clicked => {
                            root.commit_active_edit();
                            root.show_fill_dialog_clicked();
                        }
                    }
                    Button {
                        text: "Spalte teilen";
                        clicked => {
                            root.commit_active_edit();
                            root.show_split_dialog_clicked();
                        }
                    }
                    Button {
                        text: "Zeilen löschen";
                        clicked => {
                            root.commit_active_edit();
                            root.delete_marked_rows_clicked();
                        }
                    }
                }
            }
        }

        // ROW 3: TAB BAR (KOLLEKTIONEN STRIKT GETRENNT / CSV-EBENE UND ODS-EBENE)
        Rectangle {
            height: root.tab_bar_effective_height;
            background: #14161f;

            // Bottom border for tab bar
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #2a3147;
            }

            VerticalLayout {
                spacing: 4px;

                // 0. Kollektionsbasierte Tab-Gruppen (Jede Kollektion strikt getrennt!)
                if root.collection_groups.length > 0: ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 6px;

                        for group[grp_idx] in root.collection_groups: Rectangle {
                            background: #151824;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #262d40;

                            VerticalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    // Kollektions-Badge
                                    VerticalLayout {
                                        alignment: root.tabs_multiline ? start : center;
                                        padding-top: root.tabs_multiline ? 4px : 0px;
                                        Rectangle {
                                            width: 140px;
                                            height: 26px;
                                            border-radius: 4px;
                                            background: group.is_temporary ? #3b2048 : #1e293b;
                                            border-width: 1px;
                                            border-color: group.is_temporary ? #9333ea : #3b82f6;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                spacing: 4px;
                                                alignment: center;

                                                Text {
                                                    text: group.is_temporary ? "⚡ " + group.name : "📁 " + group.name;
                                                    color: group.is_temporary ? #f0abfc : #93c5fd;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: "(" + group.tab_count + ")";
                                                    color: #94a3b8;
                                                    font-size: 10px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // Einzeilig mit modernem Scrollbalken
                                    if !root.tabs_multiline: VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        grp_scroll := ScrollView {
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                padding-top: 2px;
                                                padding-bottom: 2px;
                                                spacing: 6px;
                                                alignment: start;

                                                for tab[tab_idx] in group.tabs: SingleTab {
                                                    tab: tab;
                                                    tab_idx: tab_idx;
                                                    total_tabs: group.tab_count;
                                                    full_title: true;
                                                    selected(id) => { root.tab_selected(id); }
                                                    move_left(id) => { root.tab_move_left(id); }
                                                    move_right(id) => { root.tab_move_right(id); }
                                                    move_to_collection_clicked(id) => { root.open_move_table_dialog(id); }
                                                    close_clicked(id) => { root.tab_close_clicked(id); }
                                                    commit_edit => { root.commit_active_edit(); }
                                                }
                                            }
                                        }
                                        ModernScrollBar {
                                            content_x: grp_scroll.content-x;
                                            viewport_width: grp_scroll.content-width;
                                            visible_width: grp_scroll.visible-width;
                                        }
                                    }

                                    // Mehrzeilig (4-6 Tabs pro Zeile)
                                    if root.tabs_multiline: VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        alignment: start;

                                        for row in group.tab_rows: HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;

                                            for tab[tab_idx] in row.tabs: SingleTab {
                                                tab: tab;
                                                tab_idx: tab_idx;
                                                total_tabs: group.tab_count;
                                                full_title: true;
                                                selected(id) => { root.tab_selected(id); }
                                                move_left(id) => { root.tab_move_left(id); }
                                                move_right(id) => { root.tab_move_right(id); }
                                                move_to_collection_clicked(id) => { root.open_move_table_dialog(id); }
                                                close_clicked(id) => { root.tab_close_clicked(id); }
                                                commit_edit => { root.commit_active_edit(); }
                                            }
                                        }
                                    }

                                    // Toggle Button
                                    VerticalLayout {
                                        alignment: root.tabs_multiline ? start : center;
                                        padding-top: root.tabs_multiline ? 4px : 0px;
                                        Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: root.tabs_multiline ? #1e3a8a : (multiline_touch_g.has-hover ? #2e3549 : #1a1e2d);
                                            border-width: 1px;
                                            border-color: root.tabs_multiline ? #3b82f6 : #333d54;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 5px;
                                                alignment: center;
                                                Text {
                                                    text: root.tabs_multiline ? "☰ Einzeilig" : "☷ Mehrzeilig";
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    color: root.tabs_multiline ? #93c5fd : #cbd5e1;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            multiline_touch_g := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.commit_active_edit();
                                                    root.toggle_tabs_multiline();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Fallback: 1. CSV Tab-Zeile (Sichtbar wenn keine Kollektionsgruppen)
                if root.collection_groups.length == 0 && ((root.active_view_mode == 0 || root.active_view_mode == 1) && (root.csv_tabs.length > 0 || root.active_view_mode == 1)): Rectangle {
                    height: root.tabs_multiline ? min(320px, max(68px, root.csv_tab_rows.length * 48px + 12px)) : 68px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        // Zeilen-Kennung CSV
                        VerticalLayout {
                            alignment: root.tabs_multiline ? start : center;
                            padding-top: root.tabs_multiline ? 4px : 0px;
                            Rectangle {
                                width: 72px;
                                height: 24px;
                                border-radius: 4px;
                                background: #064e3b;
                                border-width: 1px;
                                border-color: #059669;
                                Text {
                                    text: "📄 CSV (" + root.csv_tabs.length + ")";
                                    color: #6ee7b7;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Single-line Mode: Scroll Left (◀)
                        if !root.tabs_multiline: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 22px;
                                height: 28px;
                                border-radius: 4px;
                                background: tab_scroll_csv_l.has-hover ? #2e3549 : #1a1e2d;
                                border-width: 1px;
                                border-color: #333d54;
                                Text {
                                    text: "◀";
                                    font-size: 10px;
                                    color: #94a3b8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                tab_scroll_csv_l := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.csv_tab_scroll_x = min(0px, root.csv_tab_scroll_x + 180px);
                                    }
                                }
                            }
                        }

                        // Single-line Mode: ScrollView (horizontal) with modern scrollbar
                        if !root.tabs_multiline: VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            csv_scroll := ScrollView {
                                horizontal-stretch: 1;
                                content-x <=> root.csv_tab_scroll_x;
                                HorizontalLayout {
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 6px;
                                    alignment: start;

                                    for tab[tab_idx] in root.csv_tabs: SingleTab {
                                        tab: tab;
                                        tab_idx: tab_idx;
                                        total_tabs: root.csv_tabs.length;
                                        full_title: true;
                                        selected(id) => { root.tab_selected(id); }
                                        move_left(id) => { root.tab_move_left(id); }
                                        move_right(id) => { root.tab_move_right(id); }
                                        move_to_collection_clicked(id) => { root.open_move_table_dialog(id); }
                                        close_clicked(id) => { root.tab_close_clicked(id); }
                                        commit_edit => { root.commit_active_edit(); }
                                    }
                                }
                            }
                            ModernScrollBar {
                                content_x <=> root.csv_tab_scroll_x;
                                viewport_width: csv_scroll.content-width;
                                visible_width: csv_scroll.visible-width;
                            }
                        }

                        // Single-line Mode: Scroll Right (▶)
                        if !root.tabs_multiline: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 22px;
                                height: 28px;
                                border-radius: 4px;
                                background: tab_scroll_csv_r.has-hover ? #2e3549 : #1a1e2d;
                                border-width: 1px;
                                border-color: #333d54;
                                Text {
                                    text: "▶";
                                    font-size: 10px;
                                    color: #94a3b8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                tab_scroll_csv_r := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.csv_tab_scroll_x = root.csv_tab_scroll_x - 180px;
                                    }
                                }
                            }
                        }

                        // Multi-line Mode: ScrollView (vertical) with rows of tabs (No truncation!)
                        if root.tabs_multiline: ScrollView {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 6px;
                                alignment: start;

                                for row in root.csv_tab_rows: HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    for tab[tab_idx] in row.tabs: SingleTab {
                                        tab: tab;
                                        tab_idx: tab_idx;
                                        total_tabs: row.tabs.length;
                                        full_title: true;
                                        selected(id) => { root.tab_selected(id); }
                                        move_left(id) => { root.tab_move_left(id); }
                                        move_right(id) => { root.tab_move_right(id); }
                                        move_to_collection_clicked(id) => { root.open_move_table_dialog(id); }
                                        close_clicked(id) => { root.tab_close_clicked(id); }
                                        commit_edit => { root.commit_active_edit(); }
                                    }
                                }
                            }
                        }

                        // Multi-line / Single-line toggle button
                        VerticalLayout {
                            alignment: root.tabs_multiline ? start : center;
                            padding-top: root.tabs_multiline ? 4px : 0px;
                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: root.tabs_multiline ? #1e3a8a : (multiline_touch_csv.has-hover ? #2e3549 : #1a1e2d);
                                border-width: 1px;
                                border-color: root.tabs_multiline ? #3b82f6 : #333d54;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 5px;
                                    alignment: center;
                                    Text {
                                        text: root.tabs_multiline ? "☰ Einzeilig" : "☷ Mehrzeilig";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: root.tabs_multiline ? #93c5fd : #cbd5e1;
                                        vertical-alignment: center;
                                    }
                                }
                                multiline_touch_csv := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.commit_active_edit();
                                        root.toggle_tabs_multiline();
                                    }
                                }
                            }
                        }
                    }
                }

                // Trennlinie wenn beide Zeilen im Modus "Alle" sichtbar sind
                if root.active_view_mode == 0 && root.csv_tabs.length > 0 && root.ods_tabs.length > 0: Rectangle {
                    height: 1px;
                    background: #252b3d;
                }

                // 2. ODS Tab-Zeile (Sichtbar bei Modus "Alle" [0] oder "ODS" [2])
                if (root.active_view_mode == 0 && root.ods_tabs.length > 0) || root.active_view_mode == 2: Rectangle {
                    height: root.tabs_multiline ? min(320px, max(68px, root.ods_tab_rows.length * 48px + 12px)) : 68px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        // Zeilen-Kennung ODS
                        VerticalLayout {
                            alignment: root.tabs_multiline ? start : center;
                            padding-top: root.tabs_multiline ? 4px : 0px;
                            Rectangle {
                                width: 72px;
                                height: 24px;
                                border-radius: 4px;
                                background: #451a03;
                                border-width: 1px;
                                border-color: #d97706;
                                Text {
                                    text: "📊 ODS (" + root.ods_tabs.length + ")";
                                    color: #fcd34d;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Single-line Mode: Scroll Left (◀)
                        if !root.tabs_multiline: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 22px;
                                height: 28px;
                                border-radius: 4px;
                                background: tab_scroll_ods_l.has-hover ? #2e3549 : #1a1e2d;
                                border-width: 1px;
                                border-color: #333d54;
                                Text {
                                    text: "◀";
                                    font-size: 10px;
                                    color: #94a3b8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                tab_scroll_ods_l := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.ods_tab_scroll_x = min(0px, root.ods_tab_scroll_x + 180px);
                                    }
                                }
                            }
                        }

                        // Single-line Mode: ScrollView (horizontal) with modern scrollbar
                        if !root.tabs_multiline: VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            ods_scroll := ScrollView {
                                horizontal-stretch: 1;
                                content-x <=> root.ods_tab_scroll_x;
                                HorizontalLayout {
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 6px;
                                    alignment: start;

                                    for tab[tab_idx] in root.ods_tabs: SingleTab {
                                        tab: tab;
                                        tab_idx: tab_idx;
                                        total_tabs: root.ods_tabs.length;
                                        full_title: true;
                                        selected(id) => { root.tab_selected(id); }
                                        move_left(id) => { root.tab_move_left(id); }
                                        move_right(id) => { root.tab_move_right(id); }
                                        move_to_collection_clicked(id) => { root.open_move_table_dialog(id); }
                                        close_clicked(id) => { root.tab_close_clicked(id); }
                                        commit_edit => { root.commit_active_edit(); }
                                    }
                                }
                            }
                            ModernScrollBar {
                                content_x <=> root.ods_tab_scroll_x;
                                viewport_width: ods_scroll.content-width;
                                visible_width: ods_scroll.visible-width;
                            }
                        }

                        // Single-line Mode: Scroll Right (▶)
                        if !root.tabs_multiline: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 22px;
                                height: 28px;
                                border-radius: 4px;
                                background: tab_scroll_ods_r.has-hover ? #2e3549 : #1a1e2d;
                                border-width: 1px;
                                border-color: #333d54;
                                Text {
                                    text: "▶";
                                    font-size: 10px;
                                    color: #94a3b8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                tab_scroll_ods_r := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.ods_tab_scroll_x = root.ods_tab_scroll_x - 180px;
                                    }
                                }
                            }
                        }

                        // Multi-line Mode: ScrollView (vertical) with rows of tabs (No truncation!)
                        if root.tabs_multiline: ScrollView {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 6px;
                                alignment: start;

                                for row in root.ods_tab_rows: HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    for tab[tab_idx] in row.tabs: SingleTab {
                                        tab: tab;
                                        tab_idx: tab_idx;
                                        total_tabs: row.tabs.length;
                                        full_title: true;
                                        selected(id) => { root.tab_selected(id); }
                                        move_left(id) => { root.tab_move_left(id); }
                                        move_right(id) => { root.tab_move_right(id); }
                                        move_to_collection_clicked(id) => { root.open_move_table_dialog(id); }
                                        close_clicked(id) => { root.tab_close_clicked(id); }
                                        commit_edit => { root.commit_active_edit(); }
                                    }
                                }
                            }
                        }

                        // Multi-line / Single-line toggle button
                        VerticalLayout {
                            alignment: root.tabs_multiline ? start : center;
                            padding-top: root.tabs_multiline ? 4px : 0px;
                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: root.tabs_multiline ? #1e3a8a : (multiline_touch_ods.has-hover ? #2e3549 : #1a1e2d);
                                border-width: 1px;
                                border-color: root.tabs_multiline ? #3b82f6 : #333d54;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 5px;
                                    alignment: center;
                                    Text {
                                        text: root.tabs_multiline ? "☰ Einzeilig" : "☷ Mehrzeilig";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: root.tabs_multiline ? #93c5fd : #cbd5e1;
                                        vertical-alignment: center;
                                    }
                                }
                                multiline_touch_ods := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.commit_active_edit();
                                        root.toggle_tabs_multiline();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // DRAGGABLE SPLITTER ZWISCHEN TAB-LEISTE UND HAUPTBEREICH
        Rectangle {
            height: 7px;
            background: splitter_ta.has-hover || splitter_ta.pressed ? #2563eb : #181a24;

            // Visual Grip Handle in der Mitte
            Rectangle {
                width: 52px;
                height: 3px;
                background: splitter_ta.has-hover || splitter_ta.pressed ? #93c5fd : #3b4256;
                border-radius: 1.5px;
            }

            splitter_ta := TouchArea {
                mouse-cursor: row-resize;
                moved => {
                    if self.pressed {
                        let cur_h = root.tab_bar_effective_height;
                        let delta = self.mouse-y - self.pressed-y;
                        let new_h = max(50px, min(650px, cur_h + delta));
                        root.tab_bar_custom_height = new_h;
                    }
                }
                double-clicked => {
                    root.tab_bar_custom_height = 0px;
                }
            }
        }

        // TOOLBAR & SELECTION BAR
        Rectangle {
            height: 42px;
            background: #23232b;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                alignment: space-between;

                // Selection info & controls
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    // Active Level Badge (CSV-Ebene oder ODS-Ebene)
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: root.active_table_is_ods ? #451a03 : #064e3b;
                        border-width: 1px;
                        border-color: root.active_table_is_ods ? #d97706 : #059669;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            Text {
                                text: root.active_table_is_ods ? "📊 ODS-Ebene" : "📄 CSV-Ebene";
                                color: root.active_table_is_ods ? #fcd34d : #6ee7b7;
                                font-weight: 700;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.active_table_name != "": Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: #1e2230;
                        border-width: 1px;
                        border-color: #3b4258;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            Text {
                                text: "📄 " + root.active_table_name;
                                font-weight: 700;
                                font-size: 11px;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Nur Markierte Filter Pill (High-contrast Theme styling)
                    Rectangle {
                        height: 28px;
                        border-radius: 5px;
                        background: root.only_marked_active ? #78350f : (only_marked_touch.has-hover ? #2e3549 : #222536);
                        border-width: 1.5px;
                        border-color: root.only_marked_active ? #f59e0b : #475569;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            CheckBox {
                                checked: root.only_marked_active;
                                toggled => {
                                    root.commit_active_edit();
                                    root.only_marked_toggled(self.checked);
                                }
                            }

                            Text {
                                text: "Nur Markierte";
                                color: root.only_marked_active ? #fef08a : #e2e8f0;
                                font-weight: root.only_marked_active ? 700 : 600;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        only_marked_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.commit_active_edit();
                                root.only_marked_toggled(!root.only_marked_active);
                            }
                        }
                    }

                    Rectangle {
                        background: #333342;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.marked_row_count + " von " + root.total_row_count + " Zeilen markiert (" + root.rows.length + " sichtbar)";
                                color: #d1d1e0;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Button {
                        text: "Leere Zeilen markieren";
                        clicked => {
                            root.commit_active_edit();
                            root.mark_empty_rows_clicked();
                        }
                    }
                    Button {
                        text: "Auswahl aufheben";
                        clicked => {
                            root.commit_active_edit();
                            root.clear_selection_clicked();
                        }
                    }
                }

                // Search & Filter actions
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    LineEdit {
                        width: 200px;
                        placeholder-text: "Schnellsuche...";
                        text: root.search_query;
                        edited(s) => {
                            root.commit_active_edit();
                            root.search_text_changed(s);
                        }
                    }
                    Button {
                        text: "Filter leeren";
                        clicked => {
                            root.commit_active_edit();
                            root.filter_clear_all_clicked();
                        }
                    }
                    Button {
                        text: "Regeln prüfen";
                        primary: true;
                        clicked => {
                            root.commit_active_edit();
                            root.run_rules_clicked();
                        }
                    }
                }
            }
        }

        // MAIN GRID (Sticky Header + Scrollable Rows)
        Rectangle {
            background: #19191e;
            vertical-stretch: 1;

            VerticalLayout {
                // Table Header Row
                Rectangle {
                    height: 34px;
                    background: #252838;
                    clip: true;

                    // Bottom border for sticky header
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: #3a415a;
                    }

                    header_layout := HorizontalLayout {
                        x: table_scroll.content-x;

                        // Checkbox column
                        Rectangle {
                            min-width: 38px;
                            max-width: 38px;
                            preferred-width: 38px;
                            background: #252838;
                            CheckBox {
                                toggled => {
                                    root.commit_active_edit();
                                    root.select_all_toggled(self.checked);
                                }
                            }
                            Rectangle {
                                x: parent.width - 1px;
                                width: 1px;
                                background: #353b52;
                            }
                        }
                        // Row index header
                        Rectangle {
                            min-width: 50px;
                            max-width: 50px;
                            preferred-width: 50px;
                            background: #252838;
                            Text {
                                text: "#";
                                color: #9aa5c0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-weight: 600;
                            }
                            Rectangle {
                                x: parent.width - 1px;
                                width: 1px;
                                background: #353b52;
                            }
                        }

                        // Column Headers
                        for h in root.headers: Rectangle {
                            min-width: max(50px, h.width);
                            max-width: max(50px, h.width);
                            preferred-width: self.min-width;
                            background: h.is_filtered ? #373f5c : #252838;

                            Rectangle {
                                x: parent.width - 1px;
                                width: 1px;
                                background: #353b52;
                            }

                            TouchArea {
                                x: 0px;
                                width: parent.width - 34px;
                                clicked => {
                                    root.commit_active_edit();
                                    root.header_sort_clicked(h.id);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: h.name + (h.sort_dir == 1 ? " ▲" : h.sort_dir == 2 ? " ▼" : "");
                                        color: #e6ebf5;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    if h.concept != "": Text {
                                        text: "[" + h.concept + "]";
                                        color: #60a5fa;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }

                                Button {
                                    width: 24px;
                                    height: 24px;
                                    text: h.is_filtered ? "⏷" : "▼";
                                    clicked => {
                                        root.commit_active_edit();
                                        root.open_filter_popup(h.id);
                                    }
                                }
                            }

                            // Interactive Column Resize Handle on the right edge
                            Rectangle {
                                x: parent.width - 5px;
                                width: 10px;
                                height: parent.height;

                                Rectangle {
                                    x: 4px;
                                    width: 2px;
                                    height: parent.height;
                                    background: col_resizer.has-hover || col_resizer.pressed ? #3b82f6 : transparent;
                                }

                                col_resizer := TouchArea {
                                    mouse-cursor: col-resize;
                                    moved => {
                                        if self.pressed {
                                            root.column_resized(h.id, max(40px, h.width + (self.mouse-x - self.pressed-x)));
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Table Rows
                table_scroll := ScrollView {
                    VerticalLayout {
                        min-width: header_layout.min-width;
                        alignment: start;
                        for row in root.rows: Rectangle {
                            height: 28px;
                            background: row.is_marked ? #23374d : row.bg_color != transparent ? row.bg_color : (Math.mod(row.row_idx, 2) == 0 ? #191a22 : #1f202b);

                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: #292b3b;
                            }

                            HorizontalLayout {
                                // Checkbox
                                Rectangle {
                                    min-width: 38px;
                                    max-width: 38px;
                                    preferred-width: 38px;
                                    CheckBox {
                                        checked: row.is_marked;
                                        toggled => {
                                            root.commit_active_edit();
                                            root.row_mark_toggled(row.original_idx, self.checked);
                                        }
                                    }
                                    Rectangle {
                                        x: parent.width - 1px;
                                        width: 1px;
                                        background: #2a2c3a;
                                    }
                                }
                                // Row number
                                Rectangle {
                                    min-width: 50px;
                                    max-width: 50px;
                                    preferred-width: 50px;
                                    Text {
                                        text: (row.original_idx + 1);
                                        color: #7b8296;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 11px;
                                    }
                                    Rectangle {
                                        x: parent.width - 1px;
                                        width: 1px;
                                        background: #2a2c3a;
                                    }
                                }

                                // Cells
                                for cell[col_idx] in row.cells: Rectangle {
                                    min-width: col_idx < root.headers.length ? max(60px, root.headers[col_idx].width) : 150px;
                                    max-width: self.min-width;
                                    preferred-width: self.min-width;
                                    clip: true;
                                    border-width: (root.editing_row == row.original_idx && root.editing_col == col_idx) ? 1.5px : 0px;
                                    border-color: #60a5fa;
                                    background: (root.editing_row == row.original_idx && root.editing_col == col_idx) ? #141824 :
                                        cell.bg_color != transparent ? cell.bg_color :
                                        (cell.has_error ? #4d1f24 : cell.has_warning ? #4d441f : cell.has_info ? #1f3b4d :
                                        (cell_touch.has-hover ? #25293a : transparent));

                                    Rectangle {
                                        x: parent.width - 1px;
                                        width: 1px;
                                        background: #2a2c3a;
                                    }

                                    // Display mode (when not editing this cell)
                                    if root.editing_row != row.original_idx || root.editing_col != col_idx: HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: cell.text;
                                            color: cell.bg_color != transparent ? #ffffff : (cell.has_error ? #ff8a80 : cell.has_warning ? #ffd54f : #d1d1de);
                                            font-weight: cell.bg_color != transparent ? 600 : 400;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    cell_touch := TouchArea {
                                        visible: root.editing_row != row.original_idx || root.editing_col != col_idx;
                                        mouse-cursor: text;
                                        clicked => {
                                            root.commit_active_edit();
                                            root.editing_row = row.original_idx;
                                            root.editing_col = col_idx;
                                            root.editing_text = cell.text;
                                            root.editing_dirty = false;
                                        }
                                    }

                                    // Edit mode (LineEdit on top, without TouchArea blocking it)
                                    if root.editing_row == row.original_idx && root.editing_col == col_idx: LineEdit {
                                        x: 2px;
                                        y: 1px;
                                        width: parent.width - 4px;
                                        height: parent.height - 2px;
                                        text: root.editing_text;
                                        init => {
                                            self.focus();
                                        }
                                        edited(val) => {
                                            root.editing_text = val;
                                            root.editing_dirty = true;
                                        }
                                        accepted => {
                                            root.cell_edited(row.original_idx, col_idx, self.text);
                                            root.editing_row = -1;
                                            root.editing_col = -1;
                                            root.editing_dirty = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // BOTTOM DOCK (COLLAPSIBLE)
        Rectangle {
            height: root.dock_collapsed ? 32px : 180px;
            background: #202027;

            VerticalLayout {
                // Dock Header / Tab buttons
                Rectangle {
                    height: 32px;
                    background: #272732;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 4px;
                            Button {
                                text: "Regeln & Analysen (" + root.rule_summaries.length + ")";
                                primary: root.dock_tab_idx == 0;
                                clicked => { root.dock_tab_selected(0); }
                            }
                            Button {
                                text: "Vorschläge (" + root.proposals.length + ")";
                                primary: root.dock_tab_idx == 1;
                                clicked => { root.dock_tab_selected(1); }
                            }
                            Button {
                                text: "Log-Viewer (" + root.logs.length + ")";
                                primary: root.dock_tab_idx == 2;
                                clicked => { root.dock_tab_selected(2); }
                            }
                        }

                        Button {
                            text: root.dock_collapsed ? "▲ Ausklappen" : "▼ Einklappen";
                            clicked => { root.toggle_dock_collapsed(); }
                        }
                    }
                }

                // Dock Content
                if !root.dock_collapsed: Rectangle {
                    vertical-stretch: 1;

                    // Tab 0: Rules
                    if root.dock_tab_idx == 0: ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            for r in root.rule_summaries: Rectangle {
                                height: 32px;
                                background: #2a2a36;
                                border-radius: 4px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;

                                    Text {
                                        text: r.id + ": " + r.description;
                                        color: #e0e0ec;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;
                                        if r.errors > 0: Rectangle {
                                            background: #c62828;
                                            border-radius: 3px;
                                            HorizontalLayout {
                                                padding-left: 6px; padding-right: 6px;
                                                Text { text: r.errors + " Fehler"; color: #ffffff; vertical-alignment: center; }
                                            }
                                        }
                                        if r.warnings > 0: Rectangle {
                                            background: #f57f17;
                                            border-radius: 3px;
                                            HorizontalLayout {
                                                padding-left: 6px; padding-right: 6px;
                                                Text { text: r.warnings + " Warnungen"; color: #ffffff; vertical-alignment: center; }
                                            }
                                        }
                                        if r.hits > 0 && r.errors == 0 && r.warnings == 0: Rectangle {
                                            background: #1e3a5f;
                                            border-radius: 3px;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px;
                                                Text { text: r.hits + " Treffer"; color: #93c5fd; font-weight: 600; vertical-alignment: center; }
                                            }
                                        }
                                        if r.hits == 0: Text {
                                            text: "OK (0 Treffer)";
                                            color: #81c784;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Tab 1: Proposals
                    if root.dock_tab_idx == 1: ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            if root.proposals.length == 0: Text {
                                text: "Keine Vorschläge aus Tabellenvergleichen vorhanden.";
                                color: #888899;
                                horizontal-alignment: center;
                            }
                            for p[idx] in root.proposals: Rectangle {
                                height: 34px;
                                background: #2a2a36;
                                border-radius: 4px;

                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px;
                                    alignment: space-between;

                                    Text {
                                        text: "Quelle: " + p.source_table + " | Schlüssel: " + p.key_val + " (" + p.preview + ")";
                                        color: #e0e0ec;
                                        vertical-alignment: center;
                                    }

                                    Button {
                                        text: "Übernehmen";
                                        primary: true;
                                        clicked => { root.proposal_apply_clicked(idx); }
                                    }
                                }
                            }
                        }
                    }

                    // Tab 2: Logs
                    if root.dock_tab_idx == 2: VerticalLayout {
                        padding: 6px;
                        HorizontalLayout {
                            alignment: end;
                            Button {
                                text: "Logs kopieren";
                                clicked => { root.copy_logs_clicked(); }
                            }
                        }
                        ScrollView {
                            VerticalLayout {
                                for log in root.logs: Text {
                                    text: "[" + log.timestamp + "] [" + log.level + "] " + log.message;
                                    color: log.level == "ERROR" ? #ff8a80 : log.level == "WARN" ? #ffd54f : #a6a6b8;
                                    font-family: "Consolas, Courier New, monospace";
                                    font-size: 11px;
                                }
                            }
                        }
                    }
                }
            }
        }

        // FOOTER STATUS BAR
        Rectangle {
            height: 24px;
            background: #18181f;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;

                Text {
                    text: root.status_message;
                    color: #9292a4;
                    vertical-alignment: center;
                    font-size: 11px;
                }
                Text {
                    text: "Configurable CSV & ODS Analyzer (Rust + Slint)";
                    color: #646476;
                    vertical-alignment: center;
                    font-size: 11px;
                }
            }
        }
    }

    // --- ÖFFNEN DROPDOWN MENU OVERLAY ---
    if root.open_menu_visible: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.open_menu_visible = false; }
        }

        Rectangle {
            x: 12px;
            y: 44px;
            width: 240px;
            background: #252634;
            border-radius: 8px;
            border-width: 1px;
            border-color: #4b5563;
            drop-shadow-blur: 14px;
            drop-shadow-color: #000000aa;

            VerticalLayout {
                padding: 6px;
                spacing: 3px;

                Rectangle {
                    height: 32px;
                    border-radius: 5px;
                    background: op_csv.has-hover ? #34384e : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;
                        Text { text: "📄"; font-size: 14px; vertical-alignment: center; }
                        Text { text: "CSV-Datei öffnen..."; color: #e2e8f0; font-size: 12px; vertical-alignment: center; }
                    }
                    op_csv := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open_menu_visible = false;
                            root.open_csv_clicked();
                        }
                    }
                }

                Rectangle {
                    height: 32px;
                    border-radius: 5px;
                    background: op_ods.has-hover ? #34384e : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;
                        Text { text: "📊"; font-size: 14px; vertical-alignment: center; }
                        Text { text: "ODS-Arbeitsmappe öffnen..."; color: #e2e8f0; font-size: 12px; vertical-alignment: center; }
                    }
                    op_ods := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open_menu_visible = false;
                            root.open_ods_clicked();
                        }
                    }
                }

                Rectangle {
                    height: 32px;
                    border-radius: 5px;
                    background: op_folder.has-hover ? #34384e : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;
                        Text { text: "📁"; font-size: 14px; vertical-alignment: center; }
                        Text { text: "CSV-Ordner einlesen..."; color: #e2e8f0; font-size: 12px; vertical-alignment: center; }
                    }
                    op_folder := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open_menu_visible = false;
                            root.open_folder_clicked();
                        }
                    }
                }
            }
        }
    }

    // --- ÖFFNEN MIT DROPDOWN MENU OVERLAY ---
    if root.open_with_menu_visible: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.open_with_menu_visible = false; }
        }

        Rectangle {
            x: 235px;
            y: 44px;
            width: 260px;
            background: #252634;
            border-radius: 8px;
            border-width: 1px;
            border-color: #4b5563;
            drop-shadow-blur: 14px;
            drop-shadow-color: #000000aa;

            VerticalLayout {
                padding: 6px;
                spacing: 3px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-top: 4px;
                    padding-bottom: 2px;
                    Text {
                        text: "Mit externem Programm öffnen:";
                        color: #94a3b8;
                        font-size: 10px;
                        font-weight: 600;
                    }
                }

                for app in root.external_apps: Rectangle {
                    height: 32px;
                    border-radius: 5px;
                    background: ow_touch.has-hover ? #34384e : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;
                        Text { text: "🚀"; font-size: 13px; vertical-alignment: center; }
                        Text { text: app.name; color: #ffffff; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                    }
                    ow_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open_with_menu_visible = false;
                            root.open_with_app_clicked(app.id);
                        }
                    }
                }

                Rectangle { height: 1px; background: #374151; }

                Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    background: ow_cfg.has-hover ? #34384e : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;
                        Text { text: "⚙"; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Programme konfigurieren..."; color: #93c5fd; font-size: 11px; vertical-alignment: center; }
                    }
                    ow_cfg := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open_with_menu_visible = false;
                            root.show_config_clicked();
                        }
                    }
                }
            }
        }
    }

    // --- EXPORT & SYNC DROPDOWN MENU OVERLAY ---
    if root.export_sync_menu_visible: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.export_sync_menu_visible = false; }
        }

        Rectangle {
            x: 350px;
            y: 44px;
            width: 290px;
            background: #252634;
            border-radius: 8px;
            border-width: 1px;
            border-color: #4b5563;
            drop-shadow-blur: 14px;
            drop-shadow-color: #000000aa;

            VerticalLayout {
                padding: 6px;
                spacing: 3px;

                Rectangle {
                    height: 32px;
                    border-radius: 5px;
                    background: es_c2o.has-hover ? #34384e : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;
                        Text { text: "📤"; font-size: 14px; vertical-alignment: center; }
                        Text { text: "CSV ➔ ODS (In Arbeitsmappe übertragen)"; color: #e2e8f0; font-size: 12px; vertical-alignment: center; }
                    }
                    es_c2o := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.export_sync_menu_visible = false;
                            root.export_csv_to_ods_clicked();
                        }
                    }
                }

                Rectangle {
                    height: 32px;
                    border-radius: 5px;
                    background: es_o2c.has-hover ? #34384e : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;
                        Text { text: "📥"; font-size: 14px; vertical-alignment: center; }
                        Text { text: "ODS ➔ CSV (Blätter als CSV exportieren)"; color: #e2e8f0; font-size: 12px; vertical-alignment: center; }
                    }
                    es_o2c := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.export_sync_menu_visible = false;
                            root.export_ods_to_csv_clicked();
                        }
                    }
                }

                Rectangle { height: 1px; background: #374151; }

                Rectangle {
                    height: 32px;
                    border-radius: 5px;
                    background: es_diff.has-hover ? #34384e : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;
                        Text { text: "⚖️"; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Diff & Synchronisation öffnen..."; color: #e2e8f0; font-size: 12px; vertical-alignment: center; }
                    }
                    es_diff := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.export_sync_menu_visible = false;
                            root.show_diff_dialog_clicked();
                        }
                    }
                }
            }
        }
    }

    // --- KOLLEKTIONEN DROPDOWN MENU OVERLAY ---
    if root.collection_menu_visible: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.collection_menu_visible = false; }
        }

        Rectangle {
            x: 12px;
            y: 84px;
            width: 340px;
            background: #252634;
            border-radius: 8px;
            border-width: 1px;
            border-color: #4b5563;
            drop-shadow-blur: 14px;
            drop-shadow-color: #000000aa;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                HorizontalLayout {
                    padding-left: 4px;
                    padding-bottom: 2px;
                    Text {
                        text: "Kollektionen filtern (Klick = Einzeln, Checkbox = Mehrfach):";
                        color: #94a3b8;
                        font-size: 10px;
                        font-weight: 600;
                    }
                }

                Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    background: cm_all.has-hover ? #34384e : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: start;
                        Text { text: "🌐"; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Alle anzeigen (Filter aufheben)"; color: #93c5fd; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                    }
                    cm_all := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.collection_menu_visible = false;
                            root.collection_clear_filter();
                        }
                    }
                }

                Rectangle { height: 1px; background: #374151; }

                for col in root.collection_items: Rectangle {
                    height: 34px;
                    border-radius: 5px;
                    background: col.is_temporary ? (col.is_selected ? #451a03 : (cm_touch.has-hover ? #2e1a06 : transparent)) : (col.is_selected ? #1e293b : (cm_touch.has-hover ? #34384e : transparent));

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            CheckBox {
                                checked: col.is_selected;
                                toggled => { root.collection_toggled(col.name, self.checked); }
                            }

                            Rectangle {
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    if col.is_temporary: Text {
                                        text: "⚡";
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: col.name;
                                        color: col.is_temporary ? (col.is_selected ? #fef08a : #fcd34d) : (col.is_selected ? #ffffff : #cbd5e1);
                                        font-size: 12px;
                                        font-weight: col.is_selected ? 700 : 500;
                                        vertical-alignment: center;
                                    }
                                }
                                cm_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.collection_single_clicked(col.name);
                                        root.collection_menu_visible = false;
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 18px;
                                border-radius: 9px;
                                background: col.is_temporary ? (col.is_selected ? #78350f : #3d1f08) : (col.is_selected ? #1d3557 : #1e202e);
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: col.file_count + " Dateien";
                                        font-size: 10px;
                                        color: col.is_temporary ? #fef08a : (col.is_selected ? #93c5fd : #94a3b8);
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: #374151; }

                if root.has_temporary_collection: Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    background: cm_save_temp.has-hover ? #059669 : #065f46;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: start;
                        Text { text: "💾"; font-size: 12px; vertical-alignment: center; }
                        Text { text: "Temporäre Kollektion speichern..."; color: #ffffff; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                    }
                    cm_save_temp := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.collection_menu_visible = false;
                            root.show_save_collection_dialog();
                        }
                    }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 5px;
                    background: cm_cfg.has-hover ? #34384e : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: start;
                        Text { text: "⚙"; font-size: 12px; vertical-alignment: center; }
                        Text { text: "Kollektionen verwalten..."; color: #93c5fd; font-size: 11px; vertical-alignment: center; }
                    }
                    cm_cfg := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.collection_menu_visible = false;
                            root.show_config_clicked();
                        }
                    }
                }
            }
        }
    }

    // --- MARKER DROPDOWN MENU OVERLAY (triggered from top bar button "🖍 Marker ▼") ---
    if root.marker_menu_visible: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;

        TouchArea {
            clicked => { root.marker_menu_visible = false; }
        }

        Rectangle {
            x: 430px;
            y: 46px;
            width: 230px;
            background: #252634;
            border-radius: 8px;
            border-width: 1px;
            border-color: #4b5563;
            drop-shadow-blur: 14px;
            drop-shadow-color: #000000aa;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                Text {
                    text: "Textmarker-Farbe wählen:";
                    color: #9ca3af;
                    font-size: 11px;
                    font-weight: 600;
                }

                for mc in root.marker_choices: Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    background: mc_touch.has-hover ? #34384e : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 10px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                background: mc.color;
                                border-width: 1px;
                                border-color: #ffffff55;
                            }
                        }

                        Text {
                            text: mc.key;
                            color: #f3f4f6;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: mc.hex_value;
                            color: #8b92a8;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    mc_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.apply_marker_color(mc.hex_value);
                            root.marker_menu_visible = false;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #3f445a;
                }

                Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    background: clear_marker_touch.has-hover ? #4d232a : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: "✕ Marker von Auswahl löschen";
                            color: #fca5a5;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    clear_marker_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.clear_markers_clicked();
                            root.marker_menu_visible = false;
                        }
                    }
                }
            }
        }
    }

    // --- MODALS / DIALOGS OVERLAYS ---

    // 1. Column Filter Dialog (with hit counts & other active filters support)
    if root.filter_dialog_visible: Rectangle {
        background: #000000aa;
        x: 0px; y: 0px; width: parent.width; height: parent.height;

        TouchArea {}

        Rectangle {
            width: 430px;
            height: 520px;
            background: #252530;
            border-radius: 8px;
            border-width: 1px;
            border-color: #444458;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Spaltenfilter: " + root.filter_dialog_col_name;
                        font-size: 15px;
                        font-weight: 700;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        background: #1e3a5f;
                        border-radius: 4px;
                        height: 22px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.filter_dialog_total_hits + " Treffer";
                                color: #93c5fd;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: "Trefferanzahl berücksichtigt alle anderen aktiven Filter.";
                    color: #9ca3af;
                    font-size: 11px;
                }

                LineEdit {
                    placeholder-text: "Werte in dieser Spalte suchen...";
                    text: root.filter_dialog_search;
                    edited(s) => {
                        root.filter_dialog_search = s;
                        root.filter_search_changed(s);
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        text: "Alle auswählen";
                        clicked => { root.filter_select_all(true); }
                    }
                    Button {
                        text: "Keine auswählen";
                        clicked => { root.filter_select_all(false); }
                    }
                    Button {
                        text: "Spaltenfilter zurücksetzen";
                        clicked => {
                            root.filter_reset_column(root.filter_dialog_col_idx);
                            root.filter_dialog_visible = false;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: #1c1d26;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #34374a;

                    ScrollView {
                        VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            alignment: start;
                            for item[idx] in root.filter_dialog_items: VerticalLayout {
                                if item.visible: Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: item.selected ? #263147 : transparent;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: space-between;

                                        CheckBox {
                                            horizontal-stretch: 1;
                                            text: item.display_text;
                                            checked: item.selected;
                                            toggled => { root.filter_toggle_item(idx, self.checked); }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                min-width: 30px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: item.count > 0 ? #313d5a : #2a2b36;
                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    Text {
                                                        text: item.count;
                                                        color: item.count > 0 ? #93c5fd : #6b7280;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Abbrechen";
                        clicked => { root.filter_dialog_visible = false; }
                    }
                    Button {
                        text: "Filter anwenden";
                        primary: true;
                        clicked => {
                            root.filter_apply_clicked(root.filter_dialog_col_idx);
                            root.filter_dialog_visible = false;
                        }
                    }
                }
            }
        }
    }

    // 2. Smart Add Rows Dialog (C# SmartAddDialog port)
    if root.smart_add_dialog_visible: Rectangle {
        background: #000000bb;
        x: 0px; y: 0px; width: parent.width; height: parent.height;

        TouchArea {}

        Rectangle {
            width: min(parent.width - 60px, 760px);
            height: min(parent.height - 60px, 640px);
            background: #232533;
            border-radius: 10px;
            border-width: 1px;
            border-color: #47506b;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                // Dialog Header
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Neue Zeilen hinzufügen (Smart Add)";
                            font-size: 17px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                        Text {
                            text: root.smart_add_basis_text;
                            font-size: 12px;
                            color: #93c5fd;
                        }
                    }

                    Button {
                        text: "Alle Felder leeren";
                        clicked => { root.smart_add_clear_all_fields(); }
                    }
                }

                // RowCount Bar (- / LineEdit / + / +3 / +5 / +10 / +15)
                Rectangle {
                    height: 46px;
                    background: #1b1d29;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #33384d;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: "Zeilenanzahl:";
                                color: #e2e8f0;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Button {
                                width: 32px;
                                text: "−";
                                clicked => {
                                    root.set_smart_row_count(root.smart_add_row_count - 1);
                                }
                            }

                            LineEdit {
                                width: 64px;
                                text: root.smart_add_row_count_text;
                                edited(val) => {
                                    root.smart_add_row_count_text = val;
                                    if (val != "" && val.to-float() >= 1) {
                                        root.smart_add_row_count = Math.round(val.to-float());
                                    }
                                }
                            }

                            Button {
                                width: 32px;
                                text: "+";
                                clicked => {
                                    root.set_smart_row_count(root.smart_add_row_count + 1);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;

                            Text {
                                text: "Schnellwahl:";
                                color: #94a3b8;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "1";
                                clicked => { root.set_smart_row_count(1); }
                            }
                            Button {
                                text: "+3";
                                clicked => { root.set_smart_row_count(root.smart_add_row_count + 3); }
                            }
                            Button {
                                text: "+5";
                                clicked => { root.set_smart_row_count(root.smart_add_row_count + 5); }
                            }
                            Button {
                                text: "+10";
                                clicked => { root.set_smart_row_count(root.smart_add_row_count + 10); }
                            }
                            Button {
                                text: "+15";
                                clicked => { root.set_smart_row_count(root.smart_add_row_count + 15); }
                            }
                        }
                    }
                }

                // Columns and Editable Suggestion Inputs
                Rectangle {
                    vertical-stretch: 1;
                    background: #191b26;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #32374d;

                    ScrollView {
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            alignment: start;

                            for field[field_idx] in root.smart_add_fields: Rectangle {
                                background: field.dropdown_open ? #252b3d : #212432;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: field.dropdown_open ? #60a5fa : #2f354a;

                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 6px;

                                    HorizontalLayout {
                                        spacing: 10px;

                                        // Column Name + Concept
                                        VerticalLayout {
                                            width: 210px;
                                            alignment: center;
                                            Text {
                                                text: field.column_name;
                                                color: #f1f5f9;
                                                font-weight: 600;
                                                overflow: elide;
                                            }
                                            if field.concept_name != "": Text {
                                                text: "[" + field.concept_name + "]";
                                                color: #60a5fa;
                                                font-size: 11px;
                                                overflow: elide;
                                            }
                                        }

                                        // Value input + clear + suggestion dropdown toggle
                                        LineEdit {
                                            horizontal-stretch: 1;
                                            placeholder-text: "(Leer lassen zum Ignorieren)";
                                            text: field.value;
                                            edited(val) => {
                                                root.smart_add_field_edited(field_idx, val);
                                            }
                                        }

                                        if field.value != "": Button {
                                            width: 30px;
                                            text: "✕";
                                            clicked => {
                                                root.smart_add_field_edited(field_idx, "");
                                            }
                                        }

                                        Button {
                                            width: 90px;
                                            text: (field.dropdown_open ? "▲ " : "▼ ") + field.suggestions.length;
                                            clicked => {
                                                root.smart_add_toggle_dropdown(field_idx);
                                            }
                                        }
                                    }

                                    // Expandable suggestions list with counts & "... (Alle anzeigen)"
                                    if field.dropdown_open: Rectangle {
                                        height: min(170px, max(36px, field.suggestions.length * 28px + 8px));
                                        background: #161822;
                                        border-radius: 5px;
                                        border-width: 1px;
                                        border-color: #3b4461;

                                        ScrollView {
                                            VerticalLayout {
                                                padding: 4px;
                                                spacing: 2px;

                                                if field.suggestions.length == 0: Text {
                                                    text: "Keine vorhandenen Werte in den Basiszeilen.";
                                                    color: #64748b;
                                                    font-size: 12px;
                                                    horizontal-alignment: center;
                                                }

                                                for sugg[sugg_idx] in field.suggestions: Rectangle {
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: sugg_touch.has-hover ? (sugg.is_load_more ? #1e3a5f : #2a334d) : transparent;

                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        alignment: space-between;

                                                        Text {
                                                            text: sugg.is_load_more ? "🔄 " + sugg.display : sugg.value;
                                                            color: sugg.is_load_more ? #60a5fa : #e2e8f0;
                                                            font-weight: sugg.is_load_more ? 700 : 400;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                        }

                                                        if !sugg.is_load_more: Text {
                                                            text: sugg.count + "×";
                                                            color: #93c5fd;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    sugg_touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.smart_add_suggestion_selected(field_idx, sugg_idx);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Footer Actions
                HorizontalLayout {
                    spacing: 10px;
                    alignment: space-between;

                    Text {
                        text: "Hinweis: Aktive Spaltenfilter werden automatisch erweitert, damit neue Zeilen sofort sichtbar bleiben.";
                        color: #94a3b8;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "Abbrechen";
                            clicked => { root.smart_add_dialog_visible = false; }
                        }
                        Button {
                            text: "+ " + root.smart_add_row_count + (root.smart_add_row_count == 1 ? " Zeile hinzufügen" : " Zeilen hinzufügen");
                            primary: true;
                            clicked => {
                                root.confirm_smart_add_rows(root.smart_add_row_count);
                                root.smart_add_dialog_visible = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // 3. Fill Column Dialog
    if root.fill_dialog_visible: Rectangle {
        background: #000000aa;
        x: 0px; y: 0px; width: parent.width; height: parent.height;

        Rectangle {
            width: 420px;
            height: 380px;
            background: #252530;
            border-radius: 8px;
            border-width: 1px;
            border-color: #444458;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text {
                    text: "Spalte füllen";
                    font-size: 16px;
                    font-weight: 600;
                    color: #ffffff;
                }

                Text {
                    text: "Zielspalte Index: " + (root.fill_dialog_col_idx + 1);
                    color: #b0b0c2;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Statisch";
                        primary: root.fill_dialog_mode == 0;
                        clicked => { root.fill_dialog_mode = 0; }
                    }
                    Button {
                        text: "Präfix / Suffix";
                        primary: root.fill_dialog_mode == 1;
                        clicked => { root.fill_dialog_mode = 1; }
                    }
                    Button {
                        text: "Inkrement";
                        primary: root.fill_dialog_mode == 2;
                        clicked => { root.fill_dialog_mode = 2; }
                    }
                }

                if root.fill_dialog_mode == 0: LineEdit {
                    placeholder-text: "Statischer Wert...";
                    text: root.fill_static_val;
                    edited(s) => { root.fill_static_val = s; }
                }

                if root.fill_dialog_mode == 1: VerticalLayout {
                    spacing: 6px;
                    LineEdit {
                        placeholder-text: "Präfix...";
                        text: root.fill_prefix_val;
                        edited(s) => { root.fill_prefix_val = s; }
                    }
                    LineEdit {
                        placeholder-text: "Suffix...";
                        text: root.fill_suffix_val;
                        edited(s) => { root.fill_suffix_val = s; }
                    }
                }

                if root.fill_dialog_mode == 2: VerticalLayout {
                    spacing: 6px;
                    LineEdit {
                        placeholder-text: "Präfix (z. B. SRV-)...";
                        text: root.fill_prefix_val;
                        edited(s) => { root.fill_prefix_val = s; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Start:"; vertical-alignment: center; }
                        LineEdit {
                            text: root.fill_start_val;
                            edited(s) => { root.fill_start_val = s.to-float(); }
                        }
                        Text { text: "Schritt:"; vertical-alignment: center; }
                        LineEdit {
                            text: root.fill_step_val;
                            edited(s) => { root.fill_step_val = s.to-float(); }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Abbrechen";
                        clicked => { root.fill_dialog_visible = false; }
                    }
                    Button {
                        text: "Ausführen";
                        primary: true;
                        clicked => {
                            root.apply_fill_column(
                                root.fill_dialog_col_idx,
                                root.fill_dialog_mode,
                                root.fill_static_val,
                                root.fill_prefix_val,
                                root.fill_suffix_val,
                                root.fill_start_val,
                                root.fill_step_val
                            );
                            root.fill_dialog_visible = false;
                        }
                    }
                }
            }
        }
    }

    // 4. Split Column Dialog
    if root.split_dialog_visible: Rectangle {
        background: #000000aa;
        x: 0px; y: 0px; width: parent.width; height: parent.height;

        Rectangle {
            width: 420px;
            height: 280px;
            background: #252530;
            border-radius: 8px;
            border-width: 1px;
            border-color: #444458;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text {
                    text: "Spalte aufteilen";
                    font-size: 16px;
                    font-weight: 600;
                    color: #ffffff;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Trennzeichen:"; vertical-alignment: center; }
                    LineEdit {
                        width: 50px;
                        text: root.split_delimiter;
                        edited(s) => { root.split_delimiter = s; }
                    }
                }

                Text { text: "Neue Spaltennamen (kommagetrennt):"; color: #b0b0c2; }
                LineEdit {
                    text: root.split_new_cols;
                    edited(s) => { root.split_new_cols = s; }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Abbrechen";
                        clicked => { root.split_dialog_visible = false; }
                    }
                    Button {
                        text: "Aufteilen";
                        primary: true;
                        clicked => {
                            root.apply_split_column(
                                root.split_dialog_col_idx,
                                root.split_delimiter,
                                root.split_new_cols
                            );
                            root.split_dialog_visible = false;
                        }
                    }
                }
            }
        }
    }

    // 5. Sheet Selection Dialog
    if root.sheet_dialog_visible: Rectangle {
        background: #000000aa;
        x: 0px; y: 0px; width: parent.width; height: parent.height;

        Rectangle {
            width: 380px;
            height: 320px;
            background: #252530;
            border-radius: 8px;
            border-width: 1px;
            border-color: #444458;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "ODS Tabellenblatt auswählen";
                    font-size: 15px;
                    font-weight: 600;
                    color: #ffffff;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for sheet in root.available_sheets: Button {
                            text: sheet;
                            clicked => {
                                root.select_ods_sheet_clicked(sheet);
                                root.sheet_dialog_visible = false;
                            }
                        }
                    }
                }

                Button {
                    text: "Schließen";
                    clicked => { root.sheet_dialog_visible = false; }
                }
            }
        }
    }

    // 6. Diff Dialog
    if root.diff_dialog_visible: Rectangle {
        background: #000000aa;
        x: 0px; y: 0px; width: parent.width; height: parent.height;

        Rectangle {
            width: 580px;
            height: 420px;
            background: #252530;
            border-radius: 8px;
            border-width: 1px;
            border-color: #444458;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text {
                    text: "Tabellendaten-Diff (CSV <-> ODS / Extern)";
                    font-size: 16px;
                    font-weight: 600;
                    color: #ffffff;
                }

                Text {
                    text: root.diff_summary_text;
                    color: #64b5f6;
                    font-weight: 600;
                }

                ScrollView {
                    vertical-stretch: 1;
                    Text {
                        text: root.diff_details_text;
                        color: #d1d1de;
                        font-family: "Consolas, Courier New, monospace";
                        font-size: 11px;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Schließen";
                        clicked => { root.diff_dialog_visible = false; }
                    }
                    Button {
                        text: "Quelle ➔ Ziel synchronisieren";
                        primary: true;
                        clicked => {
                            root.sync_diff_clicked();
                            root.diff_dialog_visible = false;
                        }
                    }
                }
            }
        }
    }

    // 7. Save Collection Dialog
    if root.save_collection_dialog_visible: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #000000aa;

        TouchArea {
            // Modal barrier to block background clicks
        }

        Rectangle {
            width: 440px;
            height: 210px;
            background: #1f2233;
            border-radius: 10px;
            border-width: 1.5px;
            border-color: #3b82f6;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000ee;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: "💾 Kollektion speichern";
                    font-size: 16px;
                    font-weight: 700;
                    color: #ffffff;
                }

                Text {
                    text: "Geben Sie einen Namen für die Kollektion ein:";
                    font-size: 12px;
                    color: #94a3b8;
                }

                LineEdit {
                    text <=> root.save_collection_name_input;
                    placeholder-text: "Name der Kollektion...";
                    accepted => {
                        if root.save_collection_name_input != "" {
                            root.save_collection_confirmed(root.save_collection_name_input);
                            root.save_collection_dialog_visible = false;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Button {
                        text: "Abbrechen";
                        clicked => { root.save_collection_dialog_visible = false; }
                    }

                    Button {
                        text: "Speichern";
                        primary: true;
                        clicked => {
                            if root.save_collection_name_input != "" {
                                root.save_collection_confirmed(root.save_collection_name_input);
                                root.save_collection_dialog_visible = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // MOVE TABLE TO COLLECTION MODAL
    if root.move_modal_visible: Rectangle {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        background: #000000aa;

        TouchArea {
            // Modal barrier
        }

        Rectangle {
            width: 520px;
            height: root.move_modal_has_target_base_path ? 350px : 270px;
            background: #1f2233;
            border-radius: 10px;
            border-width: 1.5px;
            border-color: #6366f1;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000ee;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "⚠️";
                        font-size: 18px;
                    }
                    Text {
                        text: "Tabelle in andere Kollektion verschieben";
                        font-size: 16px;
                        font-weight: 700;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Soll die Tabelle '" + root.move_modal_table_name + "' wirklich aus Kollektion '" + root.move_modal_src_collection + "' verschoben werden?";
                    font-size: 12px;
                    color: #cbd5e1;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "Ziel-Kollektion:";
                        color: #94a3b8;
                        font-size: 12px;
                        vertical-alignment: center;
                        width: 110px;
                    }
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.move_modal_available_targets;
                        current-value: root.move_modal_target_collection;
                        selected(val) => {
                            root.move_modal_target_collection = val;
                            root.move_modal_target_changed(val);
                        }
                    }
                }

                if root.move_modal_has_target_base_path: Rectangle {
                    background: #181d2e;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #374151;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        CheckBox {
                            text: "Physische Datei auf der Festplatte in das Basisverzeichnis verschieben";
                            checked <=> root.move_modal_move_physical_file;
                        }
                        Text {
                            text: "📁 Ziel-Basispfad: " + root.move_modal_target_base_path;
                            font-size: 11px;
                            color: #93c5fd;
                            overflow: elide;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Button {
                        text: "Abbrechen";
                        clicked => { root.move_modal_visible = false; }
                    }

                    Button {
                        text: "✓ Bestätigen & Verschieben";
                        primary: true;
                        clicked => {
                            root.confirm_move_table(
                                root.move_modal_table_id,
                                root.move_modal_target_collection,
                                root.move_modal_move_physical_file
                            );
                            root.move_modal_visible = false;
                        }
                    }
                }
            }
        }
    }
}
