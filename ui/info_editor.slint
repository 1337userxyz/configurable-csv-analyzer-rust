import { Button, LineEdit, CheckBox, ScrollView, ComboBox, StandardButton } from "std-widgets.slint";
import { AppTheme, KitDeleteButton, KitCheckBox, KitRichCombo, KitComboItem, KitColorItem, KitColorCombo } from "@kit-theme";

export struct SlintColumnDisplayItem {
    id: int,
    column_name: string,
    is_visible: bool,
    width: int,
    display_index: int,
}

export struct SlintMappingItem {
    id: int,
    concept_name: string,
    csv_column_name: string,
    is_valid_header: bool,
}

export struct SlintCalcRuleItem {
    id: int,
    rule_name: string,
    target_column: string,
    formula: string,
    is_active: bool,
    is_highlighted: bool,
}

export struct SlintJoinRuleItem {
    id: int,
    rule_name: string,
    target_table: string,
    host_concept: string,
    remote_concept: string,
    imported_concept: string,
    match_preview_text: string,
    is_active: bool,
}

export struct SlintKeyMappingItem {
    step_idx: int,
    mapping_idx: int,
    host_concept: string,
    remote_concept: string,
    manual_value: string,
    is_case_sensitive: bool,
}

export struct SlintLinkStepItem {
    step_idx: int,
    step_title: string,
    target_table: string,
    hit_stat: string,
    available_host_concepts: [string],
    available_remote_concepts: [string],
    mappings: [SlintKeyMappingItem],
}

export struct SlintVirtualColumnItem {
    col_idx: int,
    remote_concept: string,
    header: string,
    binding_key: string,
    display_mode: string,
    brush_key: string,
    brush_color: color,
}

export struct SlintComparisonRuleItem {
    id: int,
    rule_name: string,
    target_table: string,
    host_concept: string,
    remote_concept: string,
    comparison_type: string,
    mismatch_brush: string,
    mismatch_target: string,
    show_proposal_dialog: bool,
    is_active: bool,
}

export struct SlintGroupValidationItem {
    id: int,
    rule_name: string,
    group_by_concept: string,
    validation_type: string, // "isUnique", "numericRange", "groupConsistency"
    param_concept: string,
    range_min: string,
    range_max: string,
    mismatch_brush: string,
    is_active: bool,
}

export struct SlintHighlightRuleItem {
    id: int,
    rule_name: string,
    column_concept: string,
    condition: string,
    value_to_match: string,
    invert_condition: bool,
    brush_key: string,
    target: string,
    priority: int,
    is_active: bool,
}

export struct SlintApplyRuleItem {
    id: int,
    rule_name: string,
    source_concept: string,
    target_table: string,
    target_concept: string,
    requires_confirmation: bool,
    execute_automatically: bool,
    is_active: bool,
}

export component InfoFileEditorWindow inherits Window {
    title: "Konfigurations-Editor (.csv.info)";
    min-width: 860px;
    min-height: 620px;
    preferred-width: 1100px;
    preferred-height: 760px;
    background: AppTheme.bg-canvas;
    default-font-family: "Segoe UI, Inter, Roboto, sans-serif";
    default-font-size: AppTheme.font-size-md;

    // Window Meta Properties
    in-out property <string> table_title: "Tabelle";
    in-out property <string> file_path_display: "";
    in-out property <bool> is_dirty: false;

    // Active Navigation Tab (0..8)
    in-out property <int> active_tab_idx: 0;

    // Validation State
    in-out property <bool> has_validation_errors: false;
    in-out property <int> error_count: 0;
    in-out property <int> warning_count: 0;
    in-out property <string> validation_banner_message: "Konfiguration ist bereit.";

    // Window Callbacks
    callback save_and_apply_clicked();
    callback cancel_clicked();
    callback run_validation_clicked();

    // Available CSV Headers & Available Tables (for dropdown/autocomplete helpers)
    in-out property <[string]> available_headers: [];
    in-out property <[string]> available_concepts: [];
    in-out property <[string]> available_tables: [];
    in-out property <[string]> available_brushes: [];
    in-out property <[KitColorItem]> color_choices: [];
    in-out property <[KitColorItem]> join_color_choices: [];
    in-out property <color> general_dirty_color: AppTheme.accent;
    in-out property <color> edit_comp_color: AppTheme.danger;
    in-out property <color> edit_group_color: AppTheme.info;
    in-out property <color> edit_hl_color: AppTheme.warning;

    // --- TAB 0: ALLGEMEIN ---
    in-out property <string> general_delimiter: ",";
    in-out property <string> general_encoding: "utf-8";
    in-out property <bool> general_has_header: true;
    in-out property <string> general_dirty_brush: "DirtyCellBrush";
    in-out property <string> general_storage_override: "Standard";
    callback general_settings_changed(string, string, bool, string, string);

    // --- TAB 1: SPALTEN & LAYOUT ---
    in-out property <[SlintColumnDisplayItem]> columns_list: [];
    in-out property <string> columns_search_filter: "";
    callback column_toggle_visibility(int, bool);
    callback column_width_changed(int, int);
    callback column_show_all();
    callback column_hide_all();
    callback column_reset_default_widths();
    callback column_move_up(int);
    callback column_move_down(int);

    // --- TAB 2: MAPPINGS & KONZEPTE ---
    in-out property <[SlintMappingItem]> mappings_list: [];
    in-out property <string> new_concept_input: "";
    in-out property <string> new_csv_col_input: "";
    callback add_mapping_clicked(string, string);
    callback delete_mapping_clicked(int);
    callback update_mapping_csv_col(int, string);

    // --- TAB 3: BERECHNUNGEN ---
    in-out property <[SlintCalcRuleItem]> calc_rules: [];
    in-out property <int> selected_calc_rule_idx: -1;
    in-out property <string> edit_calc_name: "";
    in-out property <string> edit_calc_target: "";
    in-out property <string> edit_calc_formula: "";
    in-out property <string> calc_syntax_status: "Syntax prüfen...";
    in-out property <bool> edit_calc_active: true;
    callback add_calc_rule();
    callback delete_calc_rule(int);
    callback select_calc_rule(int);
    callback save_calc_rule_edit(int, string, string, string, bool);
    callback insert_formula_token(string);
    callback test_formula_syntax(string);

    // --- TAB 4: MULTI-STEP JOINS / VIRTUELLE SPALTEN ---
    in-out property <[SlintJoinRuleItem]> join_rules: [];
    in-out property <int> selected_join_idx: -1;
    in-out property <string> edit_join_name: "";
    in-out property <string> edit_join_action_group: "";
    in-out property <string> edit_join_description: "";
    in-out property <bool> edit_join_is_active: true;
    in-out property <bool> edit_join_is_highlighted: true;

    // Steps & Columns:
    in-out property <[SlintLinkStepItem]> join_steps: [];
    in-out property <[SlintVirtualColumnItem]> join_virtual_columns: [];
    in-out property <string> join_relationship_badge: "1:1 Beziehung (Eindeutig)";
    in-out property <bool> join_relationship_is_one_to_many: false;
    in-out property <[string]> available_display_modes: ["First", "CountMerged", "CountSeparated", "CommaSeparated", "CommaSeparatedMerged", "Sum", "Average"];
    in-out property <[string]> available_final_remote_concepts: [];

    callback add_join_rule();
    callback delete_join_rule(int);
    callback select_join_rule(int);
    callback save_join_rule_edit();
    callback toggle_join_active(int, bool);

    callback add_join_step();
    callback delete_join_step(int);
    callback change_step_target_table(int, string);

    callback add_key_mapping(int);
    callback delete_key_mapping(int, int);
    callback update_key_mapping_host(int, int, string);
    callback update_key_mapping_remote(int, int, string);
    callback update_key_mapping_manual(int, int, string);
    callback update_key_mapping_case(int, int, bool);

    callback add_virtual_column();
    callback delete_virtual_column(int);
    callback update_virtual_column_concept(int, string);
    callback update_virtual_column_header(int, string);
    callback update_virtual_column_key(int, string);
    callback update_virtual_column_mode(int, string);
    callback update_virtual_column_brush(int, string);

    callback generate_join_autotext();

    // --- TAB 5: TABELLENVERGLEICHE ---
    in-out property <[SlintComparisonRuleItem]> comparison_rules: [];
    in-out property <int> selected_comp_idx: -1;
    in-out property <string> edit_comp_name: "";
    in-out property <string> edit_comp_target_table: "";
    in-out property <string> edit_comp_host_concept: "";
    in-out property <string> edit_comp_remote_concept: "";
    in-out property <string> edit_comp_type: "MissingInRemote";
    in-out property <string> edit_comp_brush: "CrossTableMismatchBrush";
    in-out property <bool> edit_comp_proposal_dialog: true;
    callback add_comparison_rule();
    callback delete_comparison_rule(int);
    callback select_comparison_rule(int);
    callback save_comparison_rule_edit(int, string, string, string, string, string, string, bool);

    // --- TAB 6: GRUPPENVALIDIERUNG ---
    in-out property <[SlintGroupValidationItem]> group_rules: [];
    in-out property <int> selected_group_idx: -1;
    in-out property <string> edit_group_name: "";
    in-out property <string> edit_group_by_concept: "";
    in-out property <string> edit_group_val_type: "isUnique";
    in-out property <string> edit_group_param_concept: "";
    in-out property <string> edit_group_min: "";
    in-out property <string> edit_group_max: "";
    in-out property <string> edit_group_brush: "UniquenessViolationBrush";
    callback add_group_rule();
    callback delete_group_rule(int);
    callback select_group_rule(int);
    callback save_group_rule_edit(int, string, string, string, string, string, string, string);

    // --- TAB 7: HIGHLIGHT-REGELN ---
    in-out property <[SlintHighlightRuleItem]> highlight_rules: [];
    in-out property <int> selected_hl_idx: -1;
    in-out property <string> edit_hl_name: "";
    in-out property <string> edit_hl_column: "";
    in-out property <string> edit_hl_condition: "Equals";
    in-out property <string> edit_hl_val: "";
    in-out property <bool> edit_hl_invert: false;
    in-out property <string> edit_hl_brush: "WarningBrush";
    in-out property <string> edit_hl_target: "Cell";
    in-out property <int> edit_hl_priority: 50;
    in-out property <bool> edit_hl_active: true;
    in-out property <[string]> available_hl_conditions: ["Equals", "Contains", "StartsWith", "EndsWith", "RegEx", "IsEmpty", "IsNotEmpty", "InList", "GreaterThan", "LessThan"];
    in-out property <[string]> available_hl_targets: ["Cell", "Row"];
    in-out property <[KitComboItem]> hl_value_counts: [];
    callback add_highlight_rule();
    callback delete_highlight_rule(int);
    callback select_highlight_rule(int);
    callback hl_column_changed(string);
    callback save_highlight_rule_edit(int, string, string, string, string, bool, string, string, int);

    // --- TAB 8: ÜBERTRAGUNGSREGELN ---
    in-out property <[SlintApplyRuleItem]> apply_rules: [];
    in-out property <int> selected_apply_idx: -1;
    in-out property <string> edit_apply_name: "";
    in-out property <string> edit_apply_source: "";
    in-out property <string> edit_apply_target_table: "$self";
    in-out property <string> edit_apply_target_concept: "";
    in-out property <bool> edit_apply_confirm: true;
    in-out property <bool> edit_apply_auto: false;
    callback add_apply_rule();
    callback delete_apply_rule(int);
    callback select_apply_rule(int);
    callback save_apply_rule_edit(int, string, string, string, string, bool, bool);

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        // TOP HEADER BAR
        Rectangle {
            height: 52px;
            background: AppTheme.bg-surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: "📋 .info Konfigurations-Editor";
                        font-size: 16px;
                        font-weight: 700;
                        color: AppTheme.text-primary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "|";
                        color: AppTheme.text-muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.table_title + " (" + root.file_path_display + ")";
                        color: AppTheme.accent;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    if root.is_dirty: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 130px;
                            height: 26px;
                            background: AppTheme.warning-bg;
                            border-radius: 4px;
                            Text {
                                text: "● Ungespeichert";
                                font-size: 11px;
                                font-weight: 600;
                                color: AppTheme.warning;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // TAB BAR (9 TABS)
        Rectangle {
            height: 48px;
            background: AppTheme.bg-canvas;
            border-radius: 6px;
            border-width: 1px;
            border-color: AppTheme.border;

            ScrollView {
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 4px;
                    padding-bottom: 2px;
                    spacing: 5px;
                    alignment: start;

                    // 1. Allgemein
                    Rectangle {
                        min-width: 105px;
                        height: 30px;
                        background: root.active_tab_idx == 0 ? AppTheme.bg-selected : (t0.has-hover ? AppTheme.bg-subtle : AppTheme.bg-surface);
                        border-radius: 4px;
                        border-width: root.active_tab_idx == 0 ? 1px : 0px;
                        border-color: AppTheme.accent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "1. Allgemein";
                                color: root.active_tab_idx == 0 ? AppTheme.text-primary : AppTheme.text-secondary;
                                font-weight: root.active_tab_idx == 0 ? 700 : 500;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        t0 := TouchArea {
                            clicked => { root.active_tab_idx = 0; }
                        }
                    }

                    // 2. Spalten & Layout
                    Rectangle {
                        min-width: 135px;
                        height: 30px;
                        background: root.active_tab_idx == 1 ? AppTheme.bg-selected : (t1.has-hover ? AppTheme.bg-subtle : AppTheme.bg-surface);
                        border-radius: 4px;
                        border-width: root.active_tab_idx == 1 ? 1px : 0px;
                        border-color: AppTheme.accent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "2. Spalten & Layout";
                                color: root.active_tab_idx == 1 ? AppTheme.text-primary : AppTheme.text-secondary;
                                font-weight: root.active_tab_idx == 1 ? 700 : 500;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        t1 := TouchArea {
                            clicked => { root.active_tab_idx = 1; }
                        }
                    }

                    // 3. Mappings
                    Rectangle {
                        min-width: 100px;
                        height: 30px;
                        background: root.active_tab_idx == 2 ? AppTheme.bg-selected : (t2.has-hover ? AppTheme.bg-subtle : AppTheme.bg-surface);
                        border-radius: 4px;
                        border-width: root.active_tab_idx == 2 ? 1px : 0px;
                        border-color: AppTheme.accent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "3. Mappings";
                                color: root.active_tab_idx == 2 ? AppTheme.text-primary : AppTheme.text-secondary;
                                font-weight: root.active_tab_idx == 2 ? 700 : 500;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        t2 := TouchArea {
                            clicked => { root.active_tab_idx = 2; }
                        }
                    }

                    // 4. Berechnungen
                    Rectangle {
                        min-width: 125px;
                        height: 30px;
                        background: root.active_tab_idx == 3 ? AppTheme.bg-selected : (t3.has-hover ? AppTheme.bg-subtle : AppTheme.bg-surface);
                        border-radius: 4px;
                        border-width: root.active_tab_idx == 3 ? 1px : 0px;
                        border-color: AppTheme.accent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "4. Berechnungen";
                                color: root.active_tab_idx == 3 ? AppTheme.text-primary : AppTheme.text-secondary;
                                font-weight: root.active_tab_idx == 3 ? 700 : 500;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        t3 := TouchArea {
                            clicked => { root.active_tab_idx = 3; }
                        }
                    }

                    // 5. Joins
                    Rectangle {
                        min-width: 85px;
                        height: 30px;
                        background: root.active_tab_idx == 4 ? AppTheme.bg-selected : (t4.has-hover ? AppTheme.bg-subtle : AppTheme.bg-surface);
                        border-radius: 4px;
                        border-width: root.active_tab_idx == 4 ? 1px : 0px;
                        border-color: AppTheme.accent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "5. Joins";
                                color: root.active_tab_idx == 4 ? AppTheme.text-primary : AppTheme.text-secondary;
                                font-weight: root.active_tab_idx == 4 ? 700 : 500;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        t4 := TouchArea {
                            clicked => { root.active_tab_idx = 4; }
                        }
                    }

                    // 6. Tabellenvergleich
                    Rectangle {
                        min-width: 145px;
                        height: 30px;
                        background: root.active_tab_idx == 5 ? AppTheme.bg-selected : (t5.has-hover ? AppTheme.bg-subtle : AppTheme.bg-surface);
                        border-radius: 4px;
                        border-width: root.active_tab_idx == 5 ? 1px : 0px;
                        border-color: AppTheme.accent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "6. Tabellenvergleich";
                                color: root.active_tab_idx == 5 ? AppTheme.text-primary : AppTheme.text-secondary;
                                font-weight: root.active_tab_idx == 5 ? 700 : 500;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        t5 := TouchArea {
                            clicked => { root.active_tab_idx = 5; }
                        }
                    }

                    // 7. Gruppenvalidierung
                    Rectangle {
                        min-width: 155px;
                        height: 30px;
                        background: root.active_tab_idx == 6 ? AppTheme.bg-selected : (t6.has-hover ? AppTheme.bg-subtle : AppTheme.bg-surface);
                        border-radius: 4px;
                        border-width: root.active_tab_idx == 6 ? 1px : 0px;
                        border-color: AppTheme.accent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "7. Gruppenvalidierung";
                                color: root.active_tab_idx == 6 ? AppTheme.text-primary : AppTheme.text-secondary;
                                font-weight: root.active_tab_idx == 6 ? 700 : 500;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        t6 := TouchArea {
                            clicked => { root.active_tab_idx = 6; }
                        }
                    }

                    // 8. Highlights
                    Rectangle {
                        min-width: 110px;
                        height: 30px;
                        background: root.active_tab_idx == 7 ? AppTheme.bg-selected : (t7.has-hover ? AppTheme.bg-subtle : AppTheme.bg-surface);
                        border-radius: 4px;
                        border-width: root.active_tab_idx == 7 ? 1px : 0px;
                        border-color: AppTheme.accent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "8. Highlights";
                                color: root.active_tab_idx == 7 ? AppTheme.text-primary : AppTheme.text-secondary;
                                font-weight: root.active_tab_idx == 7 ? 700 : 500;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        t7 := TouchArea {
                            clicked => { root.active_tab_idx = 7; }
                        }
                    }

                    // 9. Übertragungen
                    Rectangle {
                        min-width: 130px;
                        height: 30px;
                        background: root.active_tab_idx == 8 ? AppTheme.bg-selected : (t8.has-hover ? AppTheme.bg-subtle : AppTheme.bg-surface);
                        border-radius: 4px;
                        border-width: root.active_tab_idx == 8 ? 1px : 0px;
                        border-color: AppTheme.accent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "9. Übertragungen";
                                color: root.active_tab_idx == 8 ? AppTheme.text-primary : AppTheme.text-secondary;
                                font-weight: root.active_tab_idx == 8 ? 700 : 500;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        t8 := TouchArea {
                            clicked => { root.active_tab_idx = 8; }
                        }
                    }
                }
            }
        }

        // TAB CONTENT BODY
        Rectangle {
            vertical-stretch: 1;
            background: AppTheme.bg-surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border;

            // ================= TAB 0: ALLGEMEIN =================
            if root.active_tab_idx == 0: VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text { text: "CSV-Parsing & Grundkonfiguration"; font-size: 15px; font-weight: 700; color: AppTheme.text-primary; }

                HorizontalLayout {
                    spacing: 24px;

                    VerticalLayout {
                        width: 330px;
                        spacing: 6px;
                        Text { text: "Trennzeichen (Delimiter):"; color: AppTheme.text-secondary; }
                        HorizontalLayout {
                            spacing: 8px;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: ["Komma (,)", "Semikolon (;)", "Tabulator (\\t)", "Pipe (|)", "Leerzeichen ( )"];
                                current-value: root.general_delimiter == "," ? "Komma (,)" : (root.general_delimiter == ";" ? "Semikolon (;)" : (root.general_delimiter == "\\t" ? "Tabulator (\\t)" : (root.general_delimiter == "|" ? "Pipe (|)" : (root.general_delimiter == " " ? "Leerzeichen ( )" : "Benutzerdefiniert"))));
                                selected(val) => {
                                    if val == "Komma (,)" { root.general_delimiter = ","; }
                                    if val == "Semikolon (;)" { root.general_delimiter = ";"; }
                                    if val == "Tabulator (\\t)" { root.general_delimiter = "\\t"; }
                                    if val == "Pipe (|)" { root.general_delimiter = "|"; }
                                    if val == "Leerzeichen ( )" { root.general_delimiter = " "; }
                                    root.general_settings_changed(root.general_delimiter, root.general_encoding, root.general_has_header, root.general_dirty_brush, root.general_storage_override);
                                }
                            }
                            LineEdit {
                                width: 55px;
                                text: root.general_delimiter;
                                placeholder-text: "Zeichen";
                                edited(s) => {
                                    root.general_delimiter = s;
                                    root.general_settings_changed(s, root.general_encoding, root.general_has_header, root.general_dirty_brush, root.general_storage_override);
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        width: 300px;
                        spacing: 6px;
                        Text { text: "Zeichencodierung (Encoding):"; color: AppTheme.text-secondary; }
                        ComboBox {
                            model: ["utf-8", "utf-8-bom", "windows-1252", "iso-8859-1", "ascii"];
                            current-value: root.general_encoding;
                            selected(val) => {
                                root.general_encoding = val;
                                root.general_settings_changed(root.general_delimiter, val, root.general_has_header, root.general_dirty_brush, root.general_storage_override);
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 24px;

                    VerticalLayout {
                        width: 330px;
                        spacing: 6px;
                        Text { text: "Farbschlüssel für bearbeitete Zellen (Dirty):"; color: AppTheme.text-secondary; }
                        KitColorCombo {
                            choices: root.color_choices;
                            selected_key: root.general_dirty_brush;
                            selected_color: root.general_dirty_color;
                            selected(k, c) => {
                                root.general_dirty_brush = k;
                                root.general_dirty_color = c;
                                root.general_settings_changed(root.general_delimiter, root.general_encoding, root.general_has_header, k, root.general_storage_override);
                            }
                        }
                    }

                    VerticalLayout {
                        width: 300px;
                        spacing: 6px;
                        Text { text: "Speicherort-Override für diese Tabelle:"; color: AppTheme.text-secondary; }
                        ComboBox {
                            model: ["Standard (Global)", "Dateipfad (Dezentral)", "Stammverzeichnis (Zentral)", "Temporaer (RAM)"];
                            current-value: root.general_storage_override == "Dateipfad" ? "Dateipfad (Dezentral)" : (root.general_storage_override == "Stammverzeichnis" ? "Stammverzeichnis (Zentral)" : (root.general_storage_override == "Temporaer" ? "Temporaer (RAM)" : "Standard (Global)"));
                            selected(val) => {
                                if val == "Standard (Global)" { root.general_storage_override = "Standard"; }
                                if val == "Dateipfad (Dezentral)" { root.general_storage_override = "Dateipfad"; }
                                if val == "Stammverzeichnis (Zentral)" { root.general_storage_override = "Stammverzeichnis"; }
                                if val == "Temporaer (RAM)" { root.general_storage_override = "Temporaer"; }
                                root.general_settings_changed(root.general_delimiter, root.general_encoding, root.general_has_header, root.general_dirty_brush, root.general_storage_override);
                            }
                        }
                    }
                }

                Rectangle {
                    background: AppTheme.bg-selected;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: AppTheme.bg-selected;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        Text {
                            text: "ℹ Über den Speicherort-Override:";
                            font-weight: 600;
                            color: AppTheme.accent;
                        }
                        Text {
                            text: "Standardmäßig gilt die in der Hauptkonfiguration festgelegte globale Speicherstrategie.\nMit dieser Option kann für genau diese Tabelle abweichend festgelegt werden, ob ihre .csv.info dezentral neben der CSV-Datei liegt, zentral im Stammverzeichnis verwaltet wird oder nur temporär im Arbeitsspeicher verbleibt.";
                            font-size: 11px;
                            color: AppTheme.text-secondary;
                        }
                    }
                }

                KitCheckBox {
                    text: "Erste Zeile enthält Spaltennamen (Header vorhanden)";
                    checked: root.general_has_header;
                    toggled(c) => {
                        root.general_has_header = c;
                        root.general_settings_changed(root.general_delimiter, root.general_encoding, c, root.general_dirty_brush, root.general_storage_override);
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            // ================= TAB 1: SPALTEN & LAYOUT =================
            if root.active_tab_idx == 1: VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    spacing: 10px;

                    LineEdit {
                        width: 300px;
                        placeholder-text: "Spalten filtern...";
                        text: root.columns_search_filter;
                        edited(s) => { root.columns_search_filter = s; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Alle anzeigen"; clicked => { root.column_show_all(); } }
                        Button { text: "Alle ausblenden"; clicked => { root.column_hide_all(); } }
                        Button { text: "Standardbreite (150px)"; clicked => { root.column_reset_default_widths(); } }
                    }
                }

                // Table Header
                Rectangle {
                    height: 28px;
                    background: AppTheme.bg-subtle;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Text { width: 80px; text: "Sichtbar"; font-weight: 600; color: AppTheme.text-secondary; vertical-alignment: center; }
                        Text { width: 300px; text: "Spaltenname"; font-weight: 600; color: AppTheme.text-secondary; vertical-alignment: center; }
                        Text { width: 140px; text: "Breite (px)"; font-weight: 600; color: AppTheme.text-secondary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Reihenfolge"; font-weight: 600; color: AppTheme.text-secondary; vertical-alignment: center; }
                    }
                }

                // Column rows
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for col[c_idx] in root.columns_list: Rectangle {
                            height: 36px;
                            background: AppTheme.bg-canvas;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    width: 80px;
                                    alignment: center;
                                    KitCheckBox {
                                        text: "";
                                        checked: col.is_visible;
                                        toggled(c) => { root.column_toggle_visibility(c_idx, c); }
                                    }
                                }

                                Text {
                                    width: 300px;
                                    text: col.column_name;
                                    color: AppTheme.text-primary;
                                    font-weight: 600;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    width: 100px;
                                    text: col.width;
                                }

                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Button { text: "▲"; enabled: c_idx > 0; clicked => { root.column_move_up(c_idx); } }
                                    Button { text: "▼"; enabled: c_idx < root.columns_list.length - 1; clicked => { root.column_move_down(c_idx); } }
                                }
                            }
                        }
                    }
                }
            }

            // ================= TAB 2: MAPPINGS =================
            if root.active_tab_idx == 2: VerticalLayout {
                padding: 14px;
                spacing: 10px;

                Text { text: "Abstraktion zwischen Fachkonzepten und technischen CSV-Headern"; font-weight: 600; color: AppTheme.text-primary; }

                // Add mapping row
                Rectangle {
                    height: 44px;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding: 6px;
                        spacing: 10px;

                        Text { text: "Neues Mapping:"; color: AppTheme.text-secondary; vertical-alignment: center; }
                        LineEdit {
                            width: 220px;
                            placeholder-text: "Konzept (z.B. DeviceID)";
                            text: root.new_concept_input;
                            edited(s) => { root.new_concept_input = s; }
                        }
                        Text { text: "➔"; color: AppTheme.accent; vertical-alignment: center; }
                        LineEdit {
                            width: 220px;
                            placeholder-text: "CSV-Spalte (z.B. switch_hostname)";
                            text: root.new_csv_col_input;
                            edited(s) => { root.new_csv_col_input = s; }
                        }
                        Button {
                            text: "+ Hinzufügen";
                            primary: true;
                            clicked => {
                                if root.new_concept_input != "" && root.new_csv_col_input != "" {
                                    root.add_mapping_clicked(root.new_concept_input, root.new_csv_col_input);
                                    root.new_concept_input = "";
                                    root.new_csv_col_input = "";
                                }
                            }
                        }
                    }
                }

                // Table Header
                Rectangle {
                    height: 28px;
                    background: AppTheme.bg-subtle;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Text { width: 240px; text: "Fachkonzept"; font-weight: 600; color: AppTheme.text-secondary; vertical-alignment: center; }
                        Text { width: 260px; text: "Gemappte CSV-Spalte"; font-weight: 600; color: AppTheme.text-secondary; vertical-alignment: center; }
                        Text { width: 140px; text: "Integrität"; font-weight: 600; color: AppTheme.text-secondary; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Aktion"; font-weight: 600; color: AppTheme.text-secondary; vertical-alignment: center; }
                    }
                }

                // Mappings List
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for map[m_idx] in root.mappings_list: Rectangle {
                            height: 38px;
                            background: AppTheme.bg-canvas;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;

                                Text {
                                    width: 240px;
                                    text: map.concept_name;
                                    font-weight: 600;
                                    color: AppTheme.accent;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    width: 260px;
                                    text: map.csv_column_name;
                                    edited(s) => { root.update_mapping_csv_col(m_idx, s); }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 140px;
                                        height: 24px;
                                        background: map.is_valid_header ? AppTheme.success-bg : AppTheme.danger-bg;
                                        border-radius: 4px;
                                        Text {
                                            text: map.is_valid_header ? "✓ Existiert" : "⚠ Fehlt in CSV";
                                            font-size: 11px;
                                            color: map.is_valid_header ? AppTheme.success : AppTheme.danger;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    alignment: end;
                                    VerticalLayout {
                                        alignment: center;
                                        KitDeleteButton {
                                            label: "✕ Entfernen";
                                            clicked => { root.delete_mapping_clicked(m_idx); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ================= TAB 3: BERECHNUNGEN =================
            if root.active_tab_idx == 3: HorizontalLayout {
                padding: 14px;
                spacing: 12px;

                // Left: Rules list
                Rectangle {
                    width: 320px;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Berechnungsregeln:"; font-weight: 600; color: AppTheme.text-primary; vertical-alignment: center; }
                            Button { text: "+ Neu"; primary: true; clicked => { root.add_calc_rule(); } }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                for rule[r_idx] in root.calc_rules: Rectangle {
                                    height: 40px;
                                    background: root.selected_calc_rule_idx == rule.id ? AppTheme.bg-selected : AppTheme.bg-subtle;
                                    border-radius: 4px;
                                    border-width: root.selected_calc_rule_idx == rule.id ? 1px : 0px;
                                    border-color: AppTheme.accent;
                                    TouchArea {
                                        width: parent.width - 42px;
                                        clicked => {
                                            root.selected_calc_rule_idx = rule.id;
                                            root.select_calc_rule(rule.id);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        alignment: space-between;
                                        Text { text: rule.rule_name; color: AppTheme.text-primary; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                        VerticalLayout {
                                            alignment: center;
                                            KitDeleteButton {
                                                clicked => { root.delete_calc_rule(rule.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Right: Editor for selected calculation
                Rectangle {
                    vertical-stretch: 1;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        Text { text: "Berechnung konfigurieren"; font-size: 14px; font-weight: 600; color: AppTheme.text-primary; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Regel-Name:"; color: AppTheme.text-secondary; }
                                LineEdit {
                                    text: root.edit_calc_name;
                                    edited(s) => {
                                        root.edit_calc_name = s;
                                        if root.selected_calc_rule_idx >= 0 {
                                            root.save_calc_rule_edit(root.selected_calc_rule_idx, s, root.edit_calc_target, root.edit_calc_formula, root.edit_calc_active);
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Zielspalte (Header):"; color: AppTheme.text-secondary; }
                                LineEdit {
                                    text: root.edit_calc_target;
                                    edited(s) => {
                                        root.edit_calc_target = s;
                                        if root.selected_calc_rule_idx >= 0 {
                                            root.save_calc_rule_edit(root.selected_calc_rule_idx, root.edit_calc_name, s, root.edit_calc_formula, root.edit_calc_active);
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Formel-Ausdruck:"; color: AppTheme.text-secondary; }
                            LineEdit {
                                text: root.edit_calc_formula;
                                placeholder-text: "{Port} * 2 oder {Prefix} + \"-\" + {Index}";
                                edited(s) => {
                                    root.edit_calc_formula = s;
                                    root.test_formula_syntax(s);
                                    if root.selected_calc_rule_idx >= 0 {
                                        root.save_calc_rule_edit(root.selected_calc_rule_idx, root.edit_calc_name, root.edit_calc_target, s, root.edit_calc_active);
                                    }
                                }
                            }
                        }

                        // Formula Helper Toolbar
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "Operatoren:"; color: AppTheme.text-muted; vertical-alignment: center; }
                            Button { text: "+"; clicked => { root.insert_formula_token("+"); } }
                            Button { text: "-"; clicked => { root.insert_formula_token("-"); } }
                            Button { text: "*"; clicked => { root.insert_formula_token("*"); } }
                            Button { text: "/"; clicked => { root.insert_formula_token("/"); } }
                            Button { text: "("; clicked => { root.insert_formula_token("("); } }
                            Button { text: ")"; clicked => { root.insert_formula_token(")"); } }
                        }

                        // Concept Buttons Toolbar
                        Text { text: "Klickbares Konzept in Formel einfügen:"; font-size: 11px; color: AppTheme.text-muted; }
                        ScrollView {
                            height: 38px;
                            HorizontalLayout {
                                spacing: 4px;
                                for c in root.available_concepts: Button {
                                    text: "{" + c + "}";
                                    clicked => { root.insert_formula_token("{" + c + "}"); }
                                }
                            }
                        }

                        // Real-time syntax status
                        Text {
                            text: root.calc_syntax_status;
                            color: AppTheme.success;
                            font-weight: 600;
                        }

                        Rectangle { vertical-stretch: 1; }

                        HorizontalLayout {
                            alignment: end;
                            Button {
                                text: "Regel speichern";
                                primary: true;
                                clicked => {
                                    root.save_calc_rule_edit(root.selected_calc_rule_idx, root.edit_calc_name, root.edit_calc_target, root.edit_calc_formula, root.edit_calc_active);
                                }
                            }
                        }
                    }
                }
            }

            // ================= TAB 4: MULTI-STEP JOINS =================
            if root.active_tab_idx == 4: HorizontalLayout {
                padding: 14px;
                spacing: 12px;

                // Left: Rule list
                Rectangle {
                    width: 290px;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Tabellen-Joins:"; font-weight: 600; color: AppTheme.text-primary; vertical-alignment: center; }
                            Button { text: "+ Neu"; primary: true; clicked => { root.add_join_rule(); } }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                for j[j_idx] in root.join_rules: Rectangle {
                                    height: 52px;
                                    background: root.selected_join_idx == j.id ? AppTheme.bg-selected : AppTheme.bg-subtle;
                                    border-radius: 4px;
                                    border-width: root.selected_join_idx == j.id ? 1px : 0px;
                                    border-color: AppTheme.accent;
                                    TouchArea {
                                        width: parent.width - 42px;
                                        clicked => {
                                            root.selected_join_idx = j.id;
                                            root.select_join_rule(j.id);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text { text: j.rule_name; color: AppTheme.text-primary; font-weight: 600; overflow: elide; }
                                            Text { text: j.match_preview_text; font-size: 11px; color: AppTheme.accent; overflow: elide; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            KitDeleteButton {
                                                clicked => { root.delete_join_rule(j.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Right: 3-Phasen Join-Konfiguration
                Rectangle {
                    vertical-stretch: 1;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;

                    if root.selected_join_idx < 0: VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: "Wählen Sie links eine Join-Regel aus oder erstellen Sie eine neue mit '+ Neu'.";
                                color: AppTheme.text-muted;
                                font-size: 14px;
                            }
                        }
                    }

                    if root.selected_join_idx >= 0: ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 16px;

                            // ---------------- 1. BASIS-EINSTELLUNGEN ----------------
                            Rectangle {
                                background: AppTheme.bg-surface;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: AppTheme.border;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Text { text: "1. Basis-Einstellungen"; font-size: 13px; font-weight: 600; color: AppTheme.text-primary; }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 2;
                                            spacing: 4px;
                                            Text { text: "Regelname:"; color: AppTheme.text-secondary; font-size: 11px; }
                                            LineEdit {
                                                text: root.edit_join_name;
                                                edited(s) => {
                                                    root.edit_join_name = s;
                                                    root.save_join_rule_edit();
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 2;
                                            spacing: 4px;
                                            Text { text: "Aktionsgruppe:"; color: AppTheme.text-secondary; font-size: 11px; }
                                            LineEdit {
                                                text: root.edit_join_action_group;
                                                placeholder-text: "z.B. Netzwerk, Stammdaten...";
                                                edited(s) => {
                                                    root.edit_join_action_group = s;
                                                    root.save_join_rule_edit();
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 14px;
                                            padding-top: 16px;
                                            KitCheckBox {
                                                text: "Regel aktiv";
                                                checked: root.edit_join_is_active;
                                                toggled(c) => {
                                                    root.edit_join_is_active = c;
                                                    root.save_join_rule_edit();
                                                }
                                            }
                                            KitCheckBox {
                                                text: "Im Grid hervorheben";
                                                checked: root.edit_join_is_highlighted;
                                                toggled(c) => {
                                                    root.edit_join_is_highlighted = c;
                                                    root.save_join_rule_edit();
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: "Beschreibung:"; color: AppTheme.text-secondary; font-size: 11px; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            LineEdit {
                                                horizontal-stretch: 1;
                                                text: root.edit_join_description;
                                                placeholder-text: "Optionale Beschreibung der Verknüpfung...";
                                                edited(s) => {
                                                    root.edit_join_description = s;
                                                    root.save_join_rule_edit();
                                                }
                                            }
                                            Button {
                                                text: "✨ Autotext";
                                                clicked => { root.generate_join_autotext(); }
                                            }
                                        }
                                    }
                                }
                            }

                            // ---------------- 2. JOIN-KETTE (LINKSTEPS) ----------------
                            Rectangle {
                                background: AppTheme.bg-surface;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: AppTheme.border;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "2. Join-Kette (Datenfluss) - LinkSteps"; font-size: 13px; font-weight: 600; color: AppTheme.text-primary; vertical-alignment: center; }
                                        Button { text: "+ Verknüpfungsschritt hinzufügen"; clicked => { root.add_join_step(); } }
                                    }

                                    for step[s_idx] in root.join_steps: Rectangle {
                                        background: AppTheme.bg-canvas;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: AppTheme.border;
                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 8px;

                                            // Step header & status
                                            HorizontalLayout {
                                                alignment: space-between;
                                                spacing: 8px;
                                                HorizontalLayout {
                                                    spacing: 10px;
                                                    Text { text: step.step_title; font-weight: 600; color: AppTheme.text-primary; vertical-alignment: center; }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            background: AppTheme.bg-selected;
                                                            border-radius: 4px;
                                                            border-width: 1px;
                                                            border-color: AppTheme.accent;
                                                            HorizontalLayout {
                                                                padding-left: 8px;
                                                                padding-right: 8px;
                                                                padding-top: 2px;
                                                                padding-bottom: 2px;
                                                                Text { text: "📊 " + step.hit_stat; font-size: 11px; color: AppTheme.accent; font-weight: 600; vertical-alignment: center; }
                                                            }
                                                        }
                                                    }
                                                }
                                                KitDeleteButton {
                                                    label: "✕ Schritt entfernen";
                                                    clicked => { root.delete_join_step(step.step_idx); }
                                                }
                                            }

                                            // Target table selector (ComboBox)
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: "Ziel-Tabelle:"; color: AppTheme.text-secondary; vertical-alignment: center; }
                                                ComboBox {
                                                    width: 280px;
                                                    model: root.available_tables;
                                                    current-value: step.target_table;
                                                    selected(val) => { root.change_step_target_table(step.step_idx, val); }
                                                }
                                            }

                                            // KeyMappings (Conditions)
                                            VerticalLayout {
                                                spacing: 6px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text { text: "Host (Quell-Konzept)"; width: 170px; color: AppTheme.text-muted; font-size: 11px; }
                                                    Text { text: "=="; width: 18px; color: transparent; }
                                                    Text { text: "Remote (Ziel-Konzept)"; width: 170px; color: AppTheme.text-muted; font-size: 11px; }
                                                    Text { text: "Statischer Wert (opt.)"; width: 130px; color: AppTheme.text-muted; font-size: 11px; }
                                                    Text { text: "Aa"; width: 45px; color: AppTheme.text-muted; font-size: 11px; }
                                                    Text { text: ""; width: 32px; }
                                                }

                                                for m[m_idx] in step.mappings: HorizontalLayout {
                                                    spacing: 8px;
                                                    ComboBox {
                                                        width: 170px;
                                                        model: step.available_host_concepts;
                                                        current-value: m.host_concept;
                                                        selected(val) => { root.update_key_mapping_host(step.step_idx, m.mapping_idx, val); }
                                                    }
                                                    Text { text: "=="; width: 18px; vertical-alignment: center; horizontal-alignment: center; color: AppTheme.text-muted; font-weight: 600; }
                                                    ComboBox {
                                                        width: 170px;
                                                        model: step.available_remote_concepts;
                                                        current-value: m.remote_concept;
                                                        selected(val) => { root.update_key_mapping_remote(step.step_idx, m.mapping_idx, val); }
                                                    }
                                                    LineEdit {
                                                        width: 130px;
                                                        placeholder-text: "Statischer Wert...";
                                                        text: m.manual_value;
                                                        edited(s) => { root.update_key_mapping_manual(step.step_idx, m.mapping_idx, s); }
                                                    }
                                                    VerticalLayout {
                                                        width: 45px;
                                                        alignment: center;
                                                        KitCheckBox {
                                                            text: "";
                                                            checked: m.is_case_sensitive;
                                                            toggled(c) => { root.update_key_mapping_case(step.step_idx, m.mapping_idx, c); }
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        KitDeleteButton {
                                                            clicked => { root.delete_key_mapping(step.step_idx, m.mapping_idx); }
                                                        }
                                                    }
                                                }

                                                HorizontalLayout {
                                                    Button {
                                                        text: "+ Bedingung hinzufügen";
                                                        clicked => { root.add_key_mapping(step.step_idx); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ---------------- 3. SELECT (VIRTUELLE ERGEBNIS-SPALTEN) ----------------
                            Rectangle {
                                background: AppTheme.bg-surface;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: AppTheme.border;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Text { text: "3. SELECT (Virtuelle Ergebnis-Spalten)"; font-size: 13px; font-weight: 600; color: AppTheme.text-primary; vertical-alignment: center; }
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    background: root.join_relationship_is_one_to_many ? AppTheme.warning : AppTheme.success;
                                                    border-radius: 4px;
                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        padding-top: 3px;
                                                        padding-bottom: 3px;
                                                        Text { text: root.join_relationship_badge; font-size: 11px; font-weight: 600; color: AppTheme.text-primary; vertical-alignment: center; }
                                                    }
                                                }
                                            }
                                        }
                                        Button { text: "+ Virtuelle Spalte hinzufügen"; clicked => { root.add_virtual_column(); } }
                                    }

                                    // Columns Table Header
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Remote-Konzept (Ziel)"; width: 160px; color: AppTheme.text-muted; font-size: 11px; }
                                        Text { text: "Header im Grid"; width: 190px; color: AppTheme.text-muted; font-size: 11px; }
                                        Text { text: "Bindungs-Key"; width: 160px; color: AppTheme.text-muted; font-size: 11px; }
                                        Text { text: "Modus (1:N)"; width: 140px; color: AppTheme.text-muted; font-size: 11px; }
                                        Text { text: "Farb-Hervorhebung"; horizontal-stretch: 1; min-width: 170px; color: AppTheme.text-muted; font-size: 11px; }
                                        Text { text: ""; width: 32px; }
                                    }

                                    for vc[vc_idx] in root.join_virtual_columns: HorizontalLayout {
                                        spacing: 8px;
                                        ComboBox {
                                            width: 160px;
                                            model: root.available_final_remote_concepts;
                                            current-value: vc.remote_concept;
                                            selected(val) => { root.update_virtual_column_concept(vc.col_idx, val); }
                                        }
                                        LineEdit {
                                            width: 190px;
                                            text: vc.header;
                                            edited(s) => { root.update_virtual_column_header(vc.col_idx, s); }
                                        }
                                        LineEdit {
                                            width: 160px;
                                            text: vc.binding_key;
                                            edited(s) => { root.update_virtual_column_key(vc.col_idx, s); }
                                        }
                                        ComboBox {
                                            width: 140px;
                                            model: root.available_display_modes;
                                            current-value: vc.display_mode;
                                            selected(val) => { root.update_virtual_column_mode(vc.col_idx, val); }
                                        }
                                        KitColorCombo {
                                            horizontal-stretch: 1;
                                            min-width: 170px;
                                            choices: root.join_color_choices;
                                            selected_key: vc.brush_key;
                                            selected_color: vc.brush_color;
                                            selected(k, _c) => {
                                                root.update_virtual_column_brush(vc.col_idx, k);
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            KitDeleteButton {
                                                clicked => { root.delete_virtual_column(vc.col_idx); }
                                            }
                                        }
                                    }
                                }
                            }

                            // Bottom action bar
                            HorizontalLayout {
                                alignment: end;
                                Button {
                                    text: "💾 Regel speichern";
                                    primary: true;
                                    clicked => {
                                        root.save_join_rule_edit();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ================= TAB 5: TABELLENVERGLEICH =================
            if root.active_tab_idx == 5: HorizontalLayout {
                padding: 14px;
                spacing: 12px;

                Rectangle {
                    width: 320px;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Vergleichsregeln:"; font-weight: 600; color: AppTheme.text-primary; vertical-alignment: center; }
                            Button { text: "+ Neu"; primary: true; clicked => { root.add_comparison_rule(); } }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                for c[c_idx] in root.comparison_rules: Rectangle {
                                    height: 40px;
                                    background: root.selected_comp_idx == c.id ? AppTheme.bg-selected : AppTheme.bg-subtle;
                                    border-radius: 4px;
                                    border-width: root.selected_comp_idx == c.id ? 1px : 0px;
                                    border-color: AppTheme.accent;
                                    TouchArea {
                                        width: parent.width - 42px;
                                        clicked => {
                                            root.selected_comp_idx = c.id;
                                            root.select_comparison_rule(c.id);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        alignment: space-between;
                                        Text { text: c.rule_name; color: AppTheme.text-primary; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                        VerticalLayout {
                                            alignment: center;
                                            KitDeleteButton {
                                                clicked => { root.delete_comparison_rule(c.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        Text { text: "Tabellenvergleich konfigurieren"; font-size: 14px; font-weight: 600; color: AppTheme.text-primary; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Regelname:"; color: AppTheme.text-secondary; }
                                LineEdit {
                                    text: root.edit_comp_name;
                                    edited(s) => {
                                        root.edit_comp_name = s;
                                        if root.selected_comp_idx >= 0 {
                                            root.save_comparison_rule_edit(root.selected_comp_idx, s, root.edit_comp_target_table, root.edit_comp_host_concept, root.edit_comp_remote_concept, root.edit_comp_type, root.edit_comp_brush, root.edit_comp_proposal_dialog);
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Zieltabelle:"; color: AppTheme.text-secondary; }
                                ComboBox {
                                    model: root.available_tables;
                                    current-value: root.edit_comp_target_table;
                                    selected(val) => {
                                        root.edit_comp_target_table = val;
                                        if root.selected_comp_idx >= 0 {
                                            root.save_comparison_rule_edit(root.selected_comp_idx, root.edit_comp_name, val, root.edit_comp_host_concept, root.edit_comp_remote_concept, root.edit_comp_type, root.edit_comp_brush, root.edit_comp_proposal_dialog);
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Lokaler Schlüssel:"; color: AppTheme.text-secondary; }
                                ComboBox {
                                    model: root.available_concepts;
                                    current-value: root.edit_comp_host_concept;
                                    selected(val) => {
                                        root.edit_comp_host_concept = val;
                                        if root.selected_comp_idx >= 0 {
                                            root.save_comparison_rule_edit(root.selected_comp_idx, root.edit_comp_name, root.edit_comp_target_table, val, root.edit_comp_remote_concept, root.edit_comp_type, root.edit_comp_brush, root.edit_comp_proposal_dialog);
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Ziel-Schlüssel:"; color: AppTheme.text-secondary; }
                                LineEdit {
                                    text: root.edit_comp_remote_concept;
                                    edited(s) => {
                                        root.edit_comp_remote_concept = s;
                                        if root.selected_comp_idx >= 0 {
                                            root.save_comparison_rule_edit(root.selected_comp_idx, root.edit_comp_name, root.edit_comp_target_table, root.edit_comp_host_concept, s, root.edit_comp_type, root.edit_comp_brush, root.edit_comp_proposal_dialog);
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Vergleichstyp:"; color: AppTheme.text-secondary; }
                                ComboBox {
                                    model: ["MissingInRemote", "ValueMismatch", "Both"];
                                    current-value: root.edit_comp_type;
                                    selected(val) => {
                                        root.edit_comp_type = val;
                                        if root.selected_comp_idx >= 0 {
                                            root.save_comparison_rule_edit(root.selected_comp_idx, root.edit_comp_name, root.edit_comp_target_table, root.edit_comp_host_concept, root.edit_comp_remote_concept, val, root.edit_comp_brush, root.edit_comp_proposal_dialog);
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Mismatch-Farbe:"; color: AppTheme.text-secondary; }
                                KitColorCombo {
                                    choices: root.color_choices;
                                    selected_key: root.edit_comp_brush;
                                    selected_color: root.edit_comp_color;
                                    selected(k, c) => {
                                        root.edit_comp_brush = k;
                                        root.edit_comp_color = c;
                                        if root.selected_comp_idx >= 0 {
                                            root.save_comparison_rule_edit(root.selected_comp_idx, root.edit_comp_name, root.edit_comp_target_table, root.edit_comp_host_concept, root.edit_comp_remote_concept, root.edit_comp_type, k, root.edit_comp_proposal_dialog);
                                        }
                                    }
                                }
                            }
                        }

                        KitCheckBox {
                            text: "Vorschlag-Dialog anzeigen (Übernahme fehlender Zeilen ins Dock einbinden)";
                            checked: root.edit_comp_proposal_dialog;
                            toggled(c) => {
                                root.edit_comp_proposal_dialog = c;
                                if root.selected_comp_idx >= 0 {
                                    root.save_comparison_rule_edit(root.selected_comp_idx, root.edit_comp_name, root.edit_comp_target_table, root.edit_comp_host_concept, root.edit_comp_remote_concept, root.edit_comp_type, root.edit_comp_brush, c);
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }

                        HorizontalLayout {
                            alignment: end;
                            Button {
                                text: "Regel speichern";
                                primary: true;
                                clicked => {
                                    root.save_comparison_rule_edit(root.selected_comp_idx, root.edit_comp_name, root.edit_comp_target_table, root.edit_comp_host_concept, root.edit_comp_remote_concept, root.edit_comp_type, root.edit_comp_brush, root.edit_comp_proposal_dialog);
                                }
                            }
                        }
                    }
                }
            }

            // ================= TAB 6: GRUPPENVALIDIERUNG =================
            if root.active_tab_idx == 6: HorizontalLayout {
                padding: 14px;
                spacing: 12px;

                Rectangle {
                    width: 320px;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Gruppenvalidierungen:"; font-weight: 600; color: AppTheme.text-primary; vertical-alignment: center; }
                            Button { text: "+ Neu"; primary: true; clicked => { root.add_group_rule(); } }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                for g[g_idx] in root.group_rules: Rectangle {
                                    height: 40px;
                                    background: root.selected_group_idx == g.id ? AppTheme.bg-selected : AppTheme.bg-subtle;
                                    border-radius: 4px;
                                    border-width: root.selected_group_idx == g.id ? 1px : 0px;
                                    border-color: AppTheme.accent;
                                    TouchArea {
                                        width: parent.width - 42px;
                                        clicked => {
                                            root.selected_group_idx = g.id;
                                            root.select_group_rule(g.id);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        alignment: space-between;
                                        Text { text: g.rule_name; color: AppTheme.text-primary; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                        VerticalLayout {
                                            alignment: center;
                                            KitDeleteButton {
                                                clicked => { root.delete_group_rule(g.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        Text { text: "Gruppenvalidierung konfigurieren"; font-size: 14px; font-weight: 600; color: AppTheme.text-primary; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Regelname:"; color: AppTheme.text-secondary; }
                                LineEdit {
                                    text: root.edit_group_name;
                                    edited(s) => {
                                        root.edit_group_name = s;
                                        if root.selected_group_idx >= 0 {
                                            root.save_group_rule_edit(root.selected_group_idx, s, root.edit_group_by_concept, root.edit_group_val_type, root.edit_group_param_concept, root.edit_group_min, root.edit_group_max, root.edit_group_brush);
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Gruppieren nach (Konzept):"; color: AppTheme.text-secondary; }
                                ComboBox {
                                    model: root.available_concepts;
                                    current-value: root.edit_group_by_concept;
                                    selected(val) => {
                                        root.edit_group_by_concept = val;
                                        if root.selected_group_idx >= 0 {
                                            root.save_group_rule_edit(root.selected_group_idx, root.edit_group_name, val, root.edit_group_val_type, root.edit_group_param_concept, root.edit_group_min, root.edit_group_max, root.edit_group_brush);
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Prüftyp:"; color: AppTheme.text-secondary; }
                                ComboBox {
                                    model: ["isUnique", "numericRange", "groupConsistency"];
                                    current-value: root.edit_group_val_type;
                                    selected(val) => {
                                        root.edit_group_val_type = val;
                                        if root.selected_group_idx >= 0 {
                                            root.save_group_rule_edit(root.selected_group_idx, root.edit_group_name, root.edit_group_by_concept, val, root.edit_group_param_concept, root.edit_group_min, root.edit_group_max, root.edit_group_brush);
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Zu prüfendes Feld:"; color: AppTheme.text-secondary; }
                                ComboBox {
                                    model: root.available_concepts;
                                    current-value: root.edit_group_param_concept;
                                    selected(val) => {
                                        root.edit_group_param_concept = val;
                                        if root.selected_group_idx >= 0 {
                                            root.save_group_rule_edit(root.selected_group_idx, root.edit_group_name, root.edit_group_by_concept, root.edit_group_val_type, val, root.edit_group_min, root.edit_group_max, root.edit_group_brush);
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Min-Wert (nur für numericRange):"; color: AppTheme.text-secondary; }
                                LineEdit {
                                    text: root.edit_group_min;
                                    edited(s) => {
                                        root.edit_group_min = s;
                                        if root.selected_group_idx >= 0 {
                                            root.save_group_rule_edit(root.selected_group_idx, root.edit_group_name, root.edit_group_by_concept, root.edit_group_val_type, root.edit_group_param_concept, s, root.edit_group_max, root.edit_group_brush);
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Max-Wert (nur für numericRange):"; color: AppTheme.text-secondary; }
                                LineEdit {
                                    text: root.edit_group_max;
                                    edited(s) => {
                                        root.edit_group_max = s;
                                        if root.selected_group_idx >= 0 {
                                            root.save_group_rule_edit(root.selected_group_idx, root.edit_group_name, root.edit_group_by_concept, root.edit_group_val_type, root.edit_group_param_concept, root.edit_group_min, s, root.edit_group_brush);
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Mismatch-Farbe:"; color: AppTheme.text-secondary; }
                            KitColorCombo {
                                choices: root.color_choices;
                                selected_key: root.edit_group_brush;
                                selected_color: root.edit_group_color;
                                selected(k, c) => {
                                    root.edit_group_brush = k;
                                    root.edit_group_color = c;
                                    if root.selected_group_idx >= 0 {
                                        root.save_group_rule_edit(root.selected_group_idx, root.edit_group_name, root.edit_group_by_concept, root.edit_group_val_type, root.edit_group_param_concept, root.edit_group_min, root.edit_group_max, k);
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }

                        HorizontalLayout {
                            alignment: end;
                            Button {
                                text: "Regel speichern";
                                primary: true;
                                clicked => {
                                    root.save_group_rule_edit(root.selected_group_idx, root.edit_group_name, root.edit_group_by_concept, root.edit_group_val_type, root.edit_group_param_concept, root.edit_group_min, root.edit_group_max, root.edit_group_brush);
                                }
                            }
                        }
                    }
                }
            }

            // ================= TAB 7: HIGHLIGHTS =================
            if root.active_tab_idx == 7: HorizontalLayout {
                padding: 14px;
                spacing: 12px;

                Rectangle {
                    width: 320px;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Highlight-Regeln:"; font-weight: 600; color: AppTheme.text-primary; vertical-alignment: center; }
                            Button { text: "+ Neu"; primary: true; clicked => { root.add_highlight_rule(); } }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                for h[h_idx] in root.highlight_rules: Rectangle {
                                    height: 48px;
                                    background: root.selected_hl_idx == h.id ? AppTheme.bg-selected : AppTheme.bg-subtle;
                                    border-radius: 4px;
                                    border-width: root.selected_hl_idx == h.id ? 1px : 0px;
                                    border-color: AppTheme.accent;
                                    TouchArea {
                                        width: parent.width - 42px;
                                        clicked => {
                                            root.selected_hl_idx = h.id;
                                            root.select_highlight_rule(h.id);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text { text: h.rule_name; color: AppTheme.text-primary; font-weight: 600; overflow: elide; }
                                            Text {
                                                text: h.column_concept + " " + (h.invert_condition ? "NOT " : "") + h.condition + " '" + h.value_to_match + "' (" + h.target + ")";
                                                font-size: 11px;
                                                color: AppTheme.accent;
                                                overflow: elide;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            KitDeleteButton {
                                                clicked => { root.delete_highlight_rule(h.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;

                    if root.selected_hl_idx < 0: VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: "Wählen Sie links eine Highlight-Regel aus oder erstellen Sie eine neue mit '+ Neu'.";
                                color: AppTheme.text-muted;
                                font-size: 14px;
                            }
                        }
                    }

                    if root.selected_hl_idx >= 0: VerticalLayout {
                        padding: 16px;
                        spacing: 14px;
                        Text { text: "Highlight-Bedingung konfigurieren"; font-size: 14px; font-weight: 600; color: AppTheme.text-primary; }

                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Regelname:"; color: AppTheme.text-secondary; }
                                LineEdit {
                                    text: root.edit_hl_name;
                                    edited(s) => {
                                        root.edit_hl_name = s;
                                        root.save_highlight_rule_edit(root.selected_hl_idx, s, root.edit_hl_column, root.edit_hl_condition, root.edit_hl_val, root.edit_hl_invert, root.edit_hl_brush, root.edit_hl_target, root.edit_hl_priority);
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Spalte / Konzept:"; color: AppTheme.text-secondary; }
                                ComboBox {
                                    model: root.available_concepts;
                                    current-value: root.edit_hl_column;
                                    selected(val) => {
                                        root.edit_hl_column = val;
                                        root.hl_column_changed(val);
                                        root.save_highlight_rule_edit(root.selected_hl_idx, root.edit_hl_name, val, root.edit_hl_condition, root.edit_hl_val, root.edit_hl_invert, root.edit_hl_brush, root.edit_hl_target, root.edit_hl_priority);
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Bedingung:"; color: AppTheme.text-secondary; }
                                ComboBox {
                                    model: root.available_hl_conditions;
                                    current-value: root.edit_hl_condition;
                                    selected(val) => {
                                        root.edit_hl_condition = val;
                                        root.save_highlight_rule_edit(root.selected_hl_idx, root.edit_hl_name, root.edit_hl_column, val, root.edit_hl_val, root.edit_hl_invert, root.edit_hl_brush, root.edit_hl_target, root.edit_hl_priority);
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Vergleichswert (frei editierbar oder aus Spaltenwerten wählen):"; color: AppTheme.text-secondary; }
                                KitRichCombo {
                                    value <=> root.edit_hl_val;
                                    items: root.hl_value_counts;
                                    clearable: false;
                                    show-count: true;
                                    edited(s) => {
                                        root.edit_hl_val = s;
                                        root.save_highlight_rule_edit(root.selected_hl_idx, root.edit_hl_name, root.edit_hl_column, root.edit_hl_condition, s, root.edit_hl_invert, root.edit_hl_brush, root.edit_hl_target, root.edit_hl_priority);
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Farb-Schlüssel (Brush):"; color: AppTheme.text-secondary; }
                                KitColorCombo {
                                    choices: root.color_choices;
                                    selected_key: root.edit_hl_brush;
                                    selected_color: root.edit_hl_color;
                                    selected(k, c) => {
                                        root.edit_hl_brush = k;
                                        root.edit_hl_color = c;
                                        root.save_highlight_rule_edit(root.selected_hl_idx, root.edit_hl_name, root.edit_hl_column, root.edit_hl_condition, root.edit_hl_val, root.edit_hl_invert, k, root.edit_hl_target, root.edit_hl_priority);
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Ziel (Zelle oder ganze Zeile):"; color: AppTheme.text-secondary; }
                                ComboBox {
                                    model: root.available_hl_targets;
                                    current-value: root.edit_hl_target;
                                    selected(val) => {
                                        root.edit_hl_target = val;
                                        root.save_highlight_rule_edit(root.selected_hl_idx, root.edit_hl_name, root.edit_hl_column, root.edit_hl_condition, root.edit_hl_val, root.edit_hl_invert, root.edit_hl_brush, val, root.edit_hl_priority);
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 44px;
                            background: AppTheme.bg-surface;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 24px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    KitCheckBox {
                                        text: "Bedingung umkehren (NOT – treffe alle Zeilen, auf die die Bedingung NICHT zutrifft)";
                                        checked: root.edit_hl_invert;
                                        toggled(c) => {
                                            root.edit_hl_invert = c;
                                            root.save_highlight_rule_edit(root.selected_hl_idx, root.edit_hl_name, root.edit_hl_column, root.edit_hl_condition, root.edit_hl_val, c, root.edit_hl_brush, root.edit_hl_target, root.edit_hl_priority);
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }

                        HorizontalLayout {
                            alignment: end;
                            Button {
                                text: "💾 Regel speichern";
                                primary: true;
                                clicked => {
                                    root.save_highlight_rule_edit(root.selected_hl_idx, root.edit_hl_name, root.edit_hl_column, root.edit_hl_condition, root.edit_hl_val, root.edit_hl_invert, root.edit_hl_brush, root.edit_hl_target, root.edit_hl_priority);
                                }
                            }
                        }
                    }
                }
            }

            // ================= TAB 8: ÜBERTRAGUNGEN =================
            if root.active_tab_idx == 8: HorizontalLayout {
                padding: 14px;
                spacing: 12px;

                Rectangle {
                    width: 320px;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Übertragungsregeln:"; font-weight: 600; color: AppTheme.text-primary; vertical-alignment: center; }
                            Button { text: "+ Neu"; primary: true; clicked => { root.add_apply_rule(); } }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                for a[a_idx] in root.apply_rules: Rectangle {
                                    height: 40px;
                                    background: root.selected_apply_idx == a.id ? AppTheme.bg-selected : AppTheme.bg-subtle;
                                    border-radius: 4px;
                                    border-width: root.selected_apply_idx == a.id ? 1px : 0px;
                                    border-color: AppTheme.accent;
                                    TouchArea {
                                        width: parent.width - 42px;
                                        clicked => {
                                            root.selected_apply_idx = a.id;
                                            root.select_apply_rule(a.id);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        alignment: space-between;
                                        Text { text: a.rule_name; color: AppTheme.text-primary; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                        VerticalLayout {
                                            alignment: center;
                                            KitDeleteButton {
                                                clicked => { root.delete_apply_rule(a.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: AppTheme.bg-canvas;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        Text { text: "Übertragungs- & Folgeregel konfigurieren"; font-size: 14px; font-weight: 600; color: AppTheme.text-primary; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Regelname:"; color: AppTheme.text-secondary; }
                            LineEdit {
                                text: root.edit_apply_name;
                                edited(s) => {
                                    root.edit_apply_name = s;
                                    if root.selected_apply_idx >= 0 {
                                        root.save_apply_rule_edit(root.selected_apply_idx, s, root.edit_apply_source, root.edit_apply_target_table, root.edit_apply_target_concept, root.edit_apply_confirm, root.edit_apply_auto);
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Quellkonzept(e):"; color: AppTheme.text-secondary; }
                                ComboBox {
                                    model: root.available_concepts;
                                    current-value: root.edit_apply_source;
                                    selected(val) => {
                                        root.edit_apply_source = val;
                                        if root.selected_apply_idx >= 0 {
                                            root.save_apply_rule_edit(root.selected_apply_idx, root.edit_apply_name, val, root.edit_apply_target_table, root.edit_apply_target_concept, root.edit_apply_confirm, root.edit_apply_auto);
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Zieltabelle ($self oder Fremdtabelle):"; color: AppTheme.text-secondary; }
                                ComboBox {
                                    model: root.available_tables;
                                    current-value: root.edit_apply_target_table;
                                    selected(val) => {
                                        root.edit_apply_target_table = val;
                                        if root.selected_apply_idx >= 0 {
                                            root.save_apply_rule_edit(root.selected_apply_idx, root.edit_apply_name, root.edit_apply_source, val, root.edit_apply_target_concept, root.edit_apply_confirm, root.edit_apply_auto);
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Zielspalte / Konzept:"; color: AppTheme.text-secondary; }
                            LineEdit {
                                text: root.edit_apply_target_concept;
                                edited(s) => {
                                    root.edit_apply_target_concept = s;
                                    if root.selected_apply_idx >= 0 {
                                        root.save_apply_rule_edit(root.selected_apply_idx, root.edit_apply_name, root.edit_apply_source, root.edit_apply_target_table, s, root.edit_apply_confirm, root.edit_apply_auto);
                                    }
                                }
                            }
                        }

                        KitCheckBox {
                            text: "Vor Ausführung Bestätigungsdialog anzeigen";
                            checked: root.edit_apply_confirm;
                            toggled(c) => {
                                root.edit_apply_confirm = c;
                                if root.selected_apply_idx >= 0 {
                                    root.save_apply_rule_edit(root.selected_apply_idx, root.edit_apply_name, root.edit_apply_source, root.edit_apply_target_table, root.edit_apply_target_concept, c, root.edit_apply_auto);
                                }
                            }
                        }

                        KitCheckBox {
                            text: "Bei jeder Zellenänderung sofort im Hintergrund ausführen";
                            checked: root.edit_apply_auto;
                            toggled(c) => {
                                root.edit_apply_auto = c;
                                if root.selected_apply_idx >= 0 {
                                    root.save_apply_rule_edit(root.selected_apply_idx, root.edit_apply_name, root.edit_apply_source, root.edit_apply_target_table, root.edit_apply_target_concept, root.edit_apply_confirm, c);
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }

                        HorizontalLayout {
                            alignment: end;
                            Button {
                                text: "Regel speichern";
                                primary: true;
                                clicked => {
                                    root.save_apply_rule_edit(root.selected_apply_idx, root.edit_apply_name, root.edit_apply_source, root.edit_apply_target_table, root.edit_apply_target_concept, root.edit_apply_confirm, root.edit_apply_auto);
                                }
                            }
                        }
                    }
                }
            }
        }

        // BOTTOM ACTION & VALIDATION STATUS BAR
        Rectangle {
            height: 52px;
            background: AppTheme.bg-surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: AppTheme.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                // Validation Status Banner
                HorizontalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 28px;
                            background: root.has_validation_errors ? AppTheme.danger-bg : (root.warning_count > 0 ? AppTheme.warning-bg : AppTheme.success-bg);
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;

                                Text {
                                    text: root.validation_banner_message;
                                    font-weight: 600;
                                    color: root.has_validation_errors ? AppTheme.danger : (root.warning_count > 0 ? AppTheme.warning : AppTheme.success);
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Button {
                        text: "🔍 Validierung prüfen";
                        clicked => { root.run_validation_clicked(); }
                    }
                }

                // Dialog Buttons
                HorizontalLayout {
                    spacing: 10px;

                    Button {
                        text: "Abbrechen";
                        clicked => { root.cancel_clicked(); }
                    }

                    Button {
                        text: "✓ Übernehmen & Speichern";
                        primary: true;
                        enabled: !root.has_validation_errors;
                        clicked => { root.save_and_apply_clicked(); }
                    }
                }
            }
        }
    }
}
