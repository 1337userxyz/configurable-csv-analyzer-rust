import { ScrollView } from "std-widgets.slint";
import { AppTheme } from "@kit-theme";

export struct ColorChoiceItem {
    key: string,
    hex_value: string,
    color: color,
}

export component ColorComboBox {
    in-out property <[ColorChoiceItem]> choices: [];
    in-out property <string> selected_key: "";
    in-out property <color> selected_color: AppTheme.text-primary;
    callback selected(string, color);

    min-height: 32px;
    preferred-height: 32px;

    Rectangle {
        background: AppTheme.bg-subtle;
        border-radius: AppTheme.radius-sm;
        border-width: 1px;
        border-color: AppTheme.border-strong;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;

            // Icon for selected color
            Rectangle {
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                background: root.selected_color;
                border-radius: 3px;
                border-width: 1px;
                border-color: AppTheme.border-strong;
            }

            Text {
                horizontal-stretch: 1;
                text: root.selected_key != "" ? root.selected_key : "Farbe wählen...";
                color: AppTheme.text-primary;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                text: "▼";
                font-size: 10px;
                color: AppTheme.text-secondary;
                vertical-alignment: center;
            }
        }

        TouchArea {
            clicked => {
                popup.show();
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: parent.height + 2px;
        width: Math.max(parent.width, 260px);
        height: Math.min(root.choices.length * 30px + 12px, 230px);

        Rectangle {
            background: AppTheme.bg-elevated;
            border-radius: AppTheme.radius-md;
            border-width: 1px;
            border-color: AppTheme.border-strong;

            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;

                    for choice in root.choices: Rectangle {
                        height: 28px;
                        background: choice_touch.has-hover ? AppTheme.bg-hover : (choice.key == root.selected_key ? AppTheme.bg-selected : transparent);
                        border-radius: AppTheme.radius-sm;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;

                            // Icon for choice in dropdown list
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                background: choice.color;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: AppTheme.border-strong;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: choice.key;
                                color: AppTheme.text-primary;
                                font-weight: 500;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: choice.hex_value;
                                font-size: 10px;
                                font-family: "Consolas, Courier New, monospace";
                                color: AppTheme.warning;
                                vertical-alignment: center;
                            }
                        }

                        choice_touch := TouchArea {
                            clicked => {
                                root.selected_key = choice.key;
                                root.selected_color = choice.color;
                                root.selected(choice.key, choice.color);
                            }
                        }
                    }
                }
            }
        }
    }
}
